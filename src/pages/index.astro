---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionIntro from "../components/sections/SectionIntro.astro";
import SectionBrands from "../components/sections/SectionBrands.astro";
import SectionProjects from "../components/sections/SectionProjects.astro";
import SectionSkills from "../components/sections/SectionSkills.astro";
import SectionExperiences from "../components/sections/SectionExperiences.astro";
import SectionCredentials from "../components/sections/SectionCredentials.astro";
import SectionTestimonials from "../components/sections/SectionTestimonials.astro";
import SectionBlogs from "../components/sections/SectionBlogs.astro";
import SectionContributions from "../components/sections/SectionContributions.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout home={true}>

    <div class="relative flex h-min min-h-screen w-auto flex-col flex-nowrap content-center items-center justify-start gap-0 overflow-x-hidden bg-bg p-0">
        <div class="site-root contents min-h-screen w-auto">
            <main class="relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-center gap-20 bg-bg p-0 max-narrow:gap-[50px]">
                <SectionIntro />
                <SectionBrands />
                <SectionProjects home={true} limit={true} />
                <SectionSkills />
                <SectionExperiences />
                <SectionCredentials />
                <SectionTestimonials />
                <SectionBlogs home={true} limit={true} />
                <SectionContributions />
            </main>
        </div>
        <Footer />
    </div>
</BaseLayout>