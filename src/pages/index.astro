---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import SectionIntro from "../components/sections/SectionIntro.astro";
import SectionBrands from "../components/sections/SectionBrands.astro";
import SectionProjects from "../components/sections/SectionProjects.astro";
import SectionSkills from "../components/sections/SectionSkills.astro";
import SectionExperiences from "../components/sections/SectionExperiences.astro";
import SectionTestimonials from "../components/sections/SectionTestimonials.astro";
import SectionBlogs from "../components/sections/SectionBlogs.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout home={true} title="Home">

    <div class="relative flex h-min min-h-screen w-auto flex-col flex-nowrap content-center items-center justify-start gap-0 overflow-hidden bg-bg p-0">
        <div class="nav-bar-container">
            <NavBar />
        </div>
        <div class="proton-root contents min-h-screen w-auto">
            <main class="relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-center gap-[100px] bg-bg p-0 max-framer:gap-[60px]">
                <SectionIntro />
                <SectionBrands />
                <SectionProjects home={true} limit={true} />
                <SectionSkills />
                <SectionExperiences />
                <SectionTestimonials />
                <SectionBlogs home={true} limit={true} />
            </main>
        </div>
        <Footer />
    </div>

