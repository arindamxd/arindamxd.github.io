---
import ToolsPageShell from "../../components/tools/ToolsPageShell.astro";
import { siteTools } from "../../utils/tools";
---

<ToolsPageShell
    title="Tools"
    description="Private utilities for authoring and reviewing site content. More tools will land here over time."
    narrow={true}
>
    <div id="tools-hub" class="tools-hub">
        <div class="tools-hub-search">
            <label class="sr-only" for="tools-hub-search">Search tools</label>
            <input
                id="tools-hub-search"
                class="tools-input tools-hub-search-input"
                type="text"
                role="searchbox"
                placeholder="Search tools…"
                autocomplete="off"
                enterkeyhint="search"
                spellcheck="false"
            />
            <button
                type="button"
                id="tools-hub-clear"
                class="tools-hub-clear"
                aria-label="Clear search"
                hidden
            >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none">
                    <path
                        d="M4 4l8 8M12 4l-8 8"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                    ></path>
                </svg>
            </button>
        </div>

        <nav class="tools-hub-list" aria-label="Available tools">
            {
                siteTools.map((tool) => (
                    <a
                        class="tools-hub-link"
                        href={tool.href}
                        data-tool-search={`${tool.title} ${tool.description} ${tool.slug}`.toLowerCase()}
                    >
                        <p class="tools-hub-link-title">{tool.title}</p>
                        <p class="tools-hub-link-desc">{tool.description}</p>
                    </a>
                ))
            }
        </nav>

        <p id="tools-hub-empty" class="tools-hub-empty" hidden>No tools match that search.</p>

        <div class="tools-hub-design">
            <a
                class="tools-hub-design-link"
                href="/design"
                data-scramble
                data-scramble-variant="primary"
            >
                <span class="tools-hub-design-title">Design system</span>
                <span class="tools-hub-design-arrow" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10" width="10" height="10" fill="currentColor">
                        <path d="M 8.336 2.84 L 1.176 10 L 0 8.824 L 7.159 1.664 L 0.849 1.664 L 0.849 0 L 10 0 L 10 9.151 L 8.336 9.151 Z"></path>
                    </svg>
                </span>
            </a>
            <p class="tools-hub-design-desc">Tokens, type, shells, and UI recipes.</p>
        </div>
    </div>
</ToolsPageShell>

<script src="../../scripts/tools-hub.js" />
