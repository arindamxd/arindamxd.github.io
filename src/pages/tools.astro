---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";

const author = (await import("../content/author-metadata.json")).default;
const today = new Date().toISOString().slice(0, 10);
---

<BaseLayout home={false} title="Tools">
    <div class="relative flex h-min min-h-screen w-auto flex-col flex-nowrap content-center items-center justify-start gap-0 overflow-hidden bg-bg p-0">
        <div class="nav-bar-container" transition:persist="site-nav" transition:name="site-nav">
            <NavBar />
        </div>

        <div class="proton-root contents min-h-screen w-auto">
            <main
                id="tools-app"
                class="relative mx-auto flex h-min w-full max-w-[1100px] flex-none flex-col flex-nowrap content-center items-stretch justify-start gap-10 bg-bg px-5 pb-24 pt-[120px] max-narrow:gap-8 max-narrow:px-4 max-narrow:pt-[100px]"
                data-author-name={author.name}
                data-author-avatar={author.intro.avatar}
                data-today={today}
            >
                <header class="flex w-full flex-col gap-3">
                    <h1 class="m-0 font-manrope text-[50px] font-semibold leading-[110%] tracking-[-0.05em] text-text max-narrow:text-[34px]">
                        Author tools
                    </h1>
                    <p class="m-0 max-w-[560px] font-manrope text-[17px] font-semibold leading-[140%] tracking-[-0.04em] text-text/60 max-narrow:text-[15px]">
                        Draft a blog or project body, then download the Markdown (and catalog JSON) ready for <code class="tools-code">src/content/</code>.
                    </p>
                </header>

                <div
                    class="flex w-fit items-center gap-1 rounded-full border border-border bg-surface p-1"
                    role="tablist"
                    aria-label="Content type"
                >
                    <button
                        type="button"
                        role="tab"
                        id="tab-blog"
                        aria-selected="true"
                        data-tools-tab="blog"
                        class="tools-tab is-active"
                    >
                        Blog
                    </button>
                    <button
                        type="button"
                        role="tab"
                        id="tab-project"
                        aria-selected="false"
                        data-tools-tab="project"
                        class="tools-tab"
                    >
                        Project
                    </button>
                </div>

                <!-- Blog panel -->
                <section
                    id="panel-blog"
                    role="tabpanel"
                    aria-labelledby="tab-blog"
                    class="grid w-full grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-10"
                >
                    <form id="form-blog" class="flex flex-col gap-5" autocomplete="off">
                        <fieldset class="tools-fieldset">
                            <legend class="tools-legend">Catalog</legend>
                            <label class="tools-label">
                                <span>Slug</span>
                                <input class="tools-input" name="slug" type="text" placeholder="my-post" required />
                            </label>
                            <label class="tools-label">
                                <span>List title</span>
                                <input class="tools-input" name="listTitle" type="text" placeholder="Understanding iOS UIControl…" required />
                            </label>
                            <label class="tools-label">
                                <span>Thumb URL</span>
                                <input class="tools-input" name="thumb" type="url" placeholder="https://… or /assets/…" />
                            </label>
                            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                                <label class="tools-label">
                                    <span>Author name</span>
                                    <input class="tools-input" name="authorName" type="text" value={author.name} />
                                </label>
                                <label class="tools-label">
                                    <span>Date</span>
                                    <input class="tools-input" name="date" type="date" value={today} />
                                </label>
                            </div>
                            <label class="tools-label">
                                <span>Author avatar</span>
                                <input class="tools-input" name="authorAvatar" type="text" value={author.intro.avatar} />
                            </label>
                        </fieldset>

                        <fieldset class="tools-fieldset">
                            <legend class="tools-legend">Article intro (frontmatter)</legend>
                            <label class="tools-label">
                                <span>Intro title</span>
                                <input class="tools-input" name="introTitle" type="text" placeholder="Lead heading under the meta row" />
                            </label>
                            <label class="tools-label">
                                <span>Intro description</span>
                                <textarea class="tools-textarea min-h-[88px]" name="introDescription" placeholder="Short intro copy"></textarea>
                            </label>
                            <label class="tools-label">
                                <span>Banner URL</span>
                                <input class="tools-input" name="banner" type="url" placeholder="https://… wide image" />
                            </label>
                        </fieldset>

                        <fieldset class="tools-fieldset">
                            <legend class="tools-legend">Body (Markdown)</legend>
                            <div class="flex flex-wrap gap-2">
                                <button type="button" class="tools-chip" data-blog-insert="section">## Section</button>
                                <button type="button" class="tools-chip" data-blog-insert="subtitle">### Subtitle</button>
                                <button type="button" class="tools-chip" data-blog-insert="labeled">Labeled list</button>
                                <button type="button" class="tools-chip" data-blog-insert="code">Code block</button>
                            </div>
                            <label class="tools-label">
                                <span class="sr-only">Body</span>
                                <textarea
                                    class="tools-textarea min-h-[280px] font-fragment"
                                    name="body"
                                    spellcheck="true"
                                    placeholder={'## Section heading\n\nBody paragraph…\n\n### Supporting heading\n\n- **Label**: explanation\n- Plain item\n\n```swift\nlet x = 1\n```'}
                                ></textarea>
                            </label>
                        </fieldset>

                        <div class="flex flex-wrap gap-3 pt-1">
                            <button type="button" class="tools-btn-primary" data-download="blog-md">Download .md</button>
                            <button type="button" class="tools-btn-secondary" data-download="blog-json">Download catalog JSON</button>
                        </div>
                    </form>

                    <aside class="tools-preview-pane">
                        <div class="flex items-center justify-between gap-3">
                            <p class="m-0 font-manrope text-[13px] font-semibold tracking-[-0.05em] text-text/50">Preview · blogs/&lt;slug&gt;.md</p>
                            <button type="button" class="tools-chip" data-copy="blog">Copy</button>
                        </div>
                        <pre id="preview-blog" class="tools-preview" aria-live="polite"></pre>
                    </aside>
                </section>

                <!-- Project panel -->
                <section
                    id="panel-project"
                    role="tabpanel"
                    aria-labelledby="tab-project"
                    hidden
                    class="grid w-full grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-10"
                >
                    <form id="form-project" class="flex flex-col gap-5" autocomplete="off">
                        <fieldset class="tools-fieldset">
                            <legend class="tools-legend">Catalog</legend>
                            <label class="tools-label">
                                <span>Slug</span>
                                <input class="tools-input" name="slug" type="text" placeholder="camerax" required />
                            </label>
                            <label class="tools-label">
                                <span>Title</span>
                                <input class="tools-input" name="title" type="text" placeholder="CameraX" required />
                            </label>
                            <label class="tools-label">
                                <span>Short description</span>
                                <input class="tools-input" name="descShort" type="text" placeholder="Card subtitle" />
                            </label>
                            <label class="tools-label">
                                <span>Long description</span>
                                <textarea class="tools-textarea min-h-[88px]" name="descLong" placeholder="Intro paragraph under the page h1"></textarea>
                            </label>
                            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                                <label class="tools-label">
                                    <span>Thumb URL</span>
                                    <input class="tools-input" name="thumb" type="text" placeholder="/assets/projects/…/logo.svg" />
                                </label>
                                <label class="tools-label">
                                    <span>Thumb bg color</span>
                                    <input class="tools-input" name="thumbBg" type="text" placeholder="rgb(42, 41, 255)" value="rgb(42, 41, 255)" />
                                </label>
                            </div>
                            <label class="tools-label">
                                <span>Banner URL</span>
                                <input class="tools-input" name="banner" type="url" placeholder="https://… wide hero image" />
                            </label>
                        </fieldset>

                        <fieldset class="tools-fieldset">
                            <legend class="tools-legend">Header meta</legend>
                            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                                <label class="tools-label">
                                    <span>Organization</span>
                                    <input class="tools-input" name="organization" type="text" placeholder="Personal" />
                                </label>
                                <label class="tools-label">
                                    <span>Category</span>
                                    <input class="tools-input" name="category" type="text" placeholder="Productivity / Camera App" />
                                </label>
                                <label class="tools-label">
                                    <span>Released</span>
                                    <input class="tools-input" name="released" type="date" value={today} />
                                </label>
                                <label class="tools-label">
                                    <span>Updated</span>
                                    <input class="tools-input" name="updated" type="date" value={today} />
                                </label>
                                <label class="tools-label">
                                    <span>Downloads</span>
                                    <input class="tools-input" name="downloads" type="text" placeholder="100K+" />
                                </label>
                                <label class="tools-label">
                                    <span>Link</span>
                                    <input class="tools-input" name="link" type="url" placeholder="https://…" />
                                </label>
                            </div>
                        </fieldset>

                        <fieldset class="tools-fieldset">
                            <legend class="tools-legend">Project links</legend>
                            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                                <label class="tools-label">
                                    <span>Source code</span>
                                    <input class="tools-input" name="source_code" type="url" placeholder="https://github.com/…" />
                                </label>
                                <label class="tools-label flex-row items-center gap-3 sm:pt-7">
                                    <input class="size-4 accent-primary" name="privacy_policy" type="checkbox" />
                                    <span>Privacy policy page</span>
                                </label>
                            </div>
                        </fieldset>

                        <fieldset class="tools-fieldset">
                            <legend class="tools-legend">Body (Markdown · no frontmatter)</legend>
                            <div class="flex flex-wrap gap-2">
                                <button type="button" class="tools-chip" data-project-insert="pair">Image pair</button>
                                <button type="button" class="tools-chip" data-project-insert="large">Large image</button>
                                <button type="button" class="tools-chip" data-project-insert="section">## Section</button>
                                <button type="button" class="tools-chip" data-project-insert="trio">Pair + large</button>
                            </div>
                            <label class="tools-label">
                                <span class="sr-only">Body</span>
                                <textarea
                                    class="tools-textarea min-h-[280px] font-fragment"
                                    name="body"
                                    spellcheck="true"
                                    placeholder={'![Image Small Top Left](https://…)\n![Image Small Top Right](https://…)\n\n## Section heading\n\nBody paragraph…\n\n![Image Large Middle](https://…)'}
                                ></textarea>
                            </label>
                        </fieldset>

                        <div class="flex flex-wrap gap-3 pt-1">
                            <button type="button" class="tools-btn-primary" data-download="project-md">Download .md</button>
                            <button type="button" class="tools-btn-secondary" data-download="project-json">Download catalog JSON</button>
                        </div>
                    </form>

                    <aside class="tools-preview-pane">
                        <div class="flex items-center justify-between gap-3">
                            <p class="m-0 font-manrope text-[13px] font-semibold tracking-[-0.05em] text-text/50">Preview · projects/&lt;slug&gt;.md</p>
                            <button type="button" class="tools-chip" data-copy="project">Copy</button>
                        </div>
                        <pre id="preview-project" class="tools-preview" aria-live="polite"></pre>
                    </aside>
                </section>
            </main>
        </div>

        <Footer />
    </div>
</BaseLayout>

<style>
    .tools-code {
        font-family: var(--font-fragment);
        font-size: 0.9em;
        padding: 0.1em 0.35em;
        border-radius: 6px;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
    }

    .tools-tab {
        appearance: none;
        border: 0;
        cursor: pointer;
        border-radius: 9999px;
        padding: 0.7rem 1.15rem;
        font-family: var(--font-manrope);
        font-size: 14px;
        font-weight: 600;
        letter-spacing: -0.04em;
        color: var(--color-text);
        background: transparent;
        opacity: 0.55;
        transition: opacity 0.2s ease, background-color 0.2s ease, color 0.2s ease;
    }

    .tools-tab.is-active {
        opacity: 1;
        background: var(--color-text);
        color: var(--color-bg);
    }

    .tools-fieldset {
        margin: 0;
        padding: 0;
        border: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        min-width: 0;
    }

    .tools-legend {
        padding: 0;
        margin: 0 0 0.15rem;
        font-family: var(--font-manrope);
        font-size: 13px;
        font-weight: 600;
        letter-spacing: -0.05em;
        color: color-mix(in srgb, var(--color-text) 50%, transparent);
    }

    .tools-label {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        min-width: 0;
        font-family: var(--font-manrope);
        font-size: 13px;
        font-weight: 600;
        letter-spacing: -0.04em;
        color: color-mix(in srgb, var(--color-text) 70%, transparent);
    }

    .tools-input,
    .tools-textarea {
        width: 100%;
        box-sizing: border-box;
        border-radius: 14px;
        border: 1px solid var(--color-border);
        background: var(--color-surface);
        color: var(--color-text);
        padding: 0.85rem 1rem;
        font-family: var(--font-manrope);
        font-size: 15px;
        font-weight: 600;
        letter-spacing: -0.04em;
        line-height: 1.4;
        outline: none;
        transition: border-color 0.2s ease;
    }

    .tools-textarea {
        resize: vertical;
        line-height: 1.55;
    }

    .tools-input:focus,
    .tools-textarea:focus {
        border-color: var(--color-primary);
    }

    .tools-chip {
        appearance: none;
        border: 1px solid var(--color-border);
        background: var(--color-surface);
        color: var(--color-text);
        border-radius: 9999px;
        padding: 0.45rem 0.85rem;
        font-family: var(--font-manrope);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: -0.04em;
        cursor: pointer;
        transition: background-color 0.2s ease, border-color 0.2s ease;
    }

    .tools-chip:hover {
        border-color: color-mix(in srgb, var(--color-text) 35%, var(--color-border));
        background: color-mix(in srgb, var(--color-surface) 80%, var(--color-text));
    }

    .tools-btn-primary,
    .tools-btn-secondary {
        appearance: none;
        border: 0;
        cursor: pointer;
        border-radius: 9999px;
        padding: 0.85rem 1.35rem;
        font-family: var(--font-manrope);
        font-size: 14px;
        font-weight: 600;
        letter-spacing: -0.05em;
        transition: background-color 0.2s ease, color 0.2s ease, opacity 0.2s ease;
    }

    .tools-btn-primary {
        background: var(--color-primary);
        color: #fff;
    }

    .tools-btn-primary:hover {
        opacity: 0.9;
    }

    .tools-btn-secondary {
        background: var(--color-surface);
        color: var(--color-text);
        border: 1px solid var(--color-border);
    }

    .tools-btn-secondary:hover {
        border-color: color-mix(in srgb, var(--color-text) 35%, var(--color-border));
    }

    .tools-preview-pane {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        min-width: 0;
        position: sticky;
        top: 100px;
        align-self: start;
    }

    .tools-preview {
        margin: 0;
        max-height: min(70vh, 720px);
        overflow: auto;
        border-radius: 18px;
        border: 1px solid var(--color-border);
        background: var(--color-surface);
        color: var(--color-text);
        padding: 1.1rem 1.2rem;
        font-family: var(--font-fragment);
        font-size: 12px;
        font-weight: 400;
        line-height: 1.55;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
</style>

<script src="../scripts/tools-author.js" />
