---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProjectPage from "../../../components/elements/ProjectPage.astro";
import SectionProjects from "../../../components/sections/SectionProjects.astro";
import Footer from "../../../components/Footer.astro";
import { getProjects } from "../../../utils/projects";
import {
    breadcrumbJsonLd,
    canonicalFromPathname,
    isoDate,
    keywordsFromCategory,
    softwareApplicationJsonLd,
    uniqueKeywords,
    webPageJsonLd,
} from "../../../utils/seo";

const { project } = Astro.props;

export async function getStaticPaths() {
    return getProjects().map((project) => ({
        params: { slug: project.slug },
        props: { project },
    }));
}

const description = project.desc.long || project.desc.short;
const image = project.images.banner || project.images.thumb;
const published = isoDate(project.header.released_date);
const modified = isoDate(project.header.updated_date);
const canonicalPath = `/projects/${project.slug}/`;
const pageUrl = canonicalFromPathname(canonicalPath);
const appId = `${pageUrl}#app`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const keywords = uniqueKeywords(
    project.title,
    "Android",
    keywordsFromCategory(project.header.category),
);
const featureList = project.page.body.flatMap((block) =>
    block.type === "content" ? [block.title] : [],
);
const jsonLd = [
    webPageJsonLd({
        name: project.title,
        path: canonicalPath,
        description,
        image,
        datePublished: published,
        dateModified: modified,
        keywords,
        mainEntityId: appId,
        breadcrumbId,
    }),
    softwareApplicationJsonLd({
        name: project.title,
        description,
        path: canonicalPath,
        image,
        thumb: project.images.thumb,
        category: project.header.category,
        datePublished: published,
        dateModified: modified,
        installUrl: project.header.link,
        sourceCode: project.source_code,
        featureList,
        keywords,
    }),
    breadcrumbJsonLd(
        [
            { name: "Home", path: "/" },
            { name: "Projects", path: "/projects/" },
            { name: project.title, path: canonicalPath },
        ],
        breadcrumbId,
    ),
];
---

<BaseLayout
    home={false}
    title={project.title}
    description={description}
    image={image}
    imageAlt={`${project.title} — ${project.desc.short}`}
    type="website"
    publishedTime={published}
    modifiedTime={modified}
    jsonLd={jsonLd}
>

    <div class="relative flex h-min min-h-screen w-auto flex-col flex-nowrap content-center items-center justify-start gap-0 overflow-x-hidden bg-bg p-0">
        <div class="site-root contents min-h-screen w-auto">
            <main id="main" class="relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-center gap-20 bg-bg p-0 max-narrow:gap-[50px]">
                <ProjectPage project={project} />
                <SectionProjects slug={true} limit={true} current={project} />
            </main>
        </div>
        <Footer />
    </div>
</BaseLayout>
