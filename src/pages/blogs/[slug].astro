---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPage from "../../components/elements/BlogPage.astro";
import SectionBlogs from "../../components/sections/SectionBlogs.astro";
import Footer from "../../components/Footer.astro";

import { blogWordCount, getBlogCatalogMeta, getBlogs } from "../../utils/blogs";
import {
    blogPostingJsonLd,
    breadcrumbJsonLd,
    canonicalFromPathname,
    isoDate,
    metaDescription,
    uniqueKeywords,
    webPageJsonLd,
} from "../../utils/seo";

const { blog } = Astro.props;

export async function getStaticPaths() {
    return getBlogs().map((blog) => ({
        params: { slug: blog.slug },
        props: { blog },
    }));
}

const catalog = getBlogCatalogMeta();
const description = metaDescription(blog.page.intro.paragraph);
const image = blog.page.intro.banner || blog.thumb;
const publishedIso = isoDate(blog.date);
const canonicalPath = `/blogs/${blog.slug}/`;
const pageUrl = canonicalFromPathname(canonicalPath);
const articleId = `${pageUrl}#article`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const keywords = uniqueKeywords(blog.tags);
const jsonLd = [
    webPageJsonLd({
        name: blog.title,
        path: canonicalPath,
        description,
        image,
        datePublished: publishedIso,
        dateModified: publishedIso,
        keywords,
        mainEntityId: articleId,
        breadcrumbId,
    }),
    blogPostingJsonLd({
        title: blog.title,
        description,
        path: canonicalPath,
        image,
        datePublished: publishedIso,
        dateModified: publishedIso,
        wordCount: blogWordCount(blog),
        keywords,
        section: catalog.title,
    }),
    breadcrumbJsonLd(
        [
            { name: "Home", path: "/" },
            { name: "Blog", path: "/blogs/" },
            { name: blog.title, path: canonicalPath },
        ],
        breadcrumbId,
    ),
];
---

<BaseLayout
    home={false}
    title={blog.title}
    description={description}
    image={image}
    imageAlt={blog.title}
    type="article"
    publishedTime={publishedIso}
    modifiedTime={publishedIso}
    section={catalog.title}
    tags={keywords}
    jsonLd={jsonLd}
>

    <div class="relative flex h-min min-h-screen w-auto flex-col flex-nowrap content-center items-center justify-start gap-0 overflow-x-hidden bg-bg p-0">
        <div class="site-root contents min-h-screen w-auto">
            <main id="main" class="relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-center gap-20 bg-bg p-0 max-narrow:gap-[50px]">
                <BlogPage blog={blog} />
                <SectionBlogs slug={true} limit={true} current={blog} />
            </main>
        </div>
        <Footer />
    </div>
</BaseLayout>
