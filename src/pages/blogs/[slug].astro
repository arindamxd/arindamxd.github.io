---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPage from "../../components/elements/BlogPage.astro";
import SectionBlogs from "../../components/sections/SectionBlogs.astro";
import Footer from "../../components/Footer.astro";

import { getBlogs } from "../../utils/blogs";
import { absoluteUrl, siteAuthor, siteOrigin } from "../../utils/seo";

// props
const { blog } = Astro.props;

export async function getStaticPaths() {
    return getBlogs().map((blog) => ({
        params: { slug: blog.slug },
        props: { blog },
    }));
}

const description = blog.page.intro.paragraph;
const image = blog.page.intro.banner || blog.thumb;
const jsonLd = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: blog.title,
    description,
    image: absoluteUrl(image),
    datePublished: blog.date.toISOString(),
    author: {
        "@type": "Person",
        name: blog.author.name,
        url: siteOrigin + "/",
    },
    publisher: {
        "@type": "Person",
        name: siteAuthor.name,
        url: siteOrigin + "/",
    },
    mainEntityOfPage: absoluteUrl(`/blogs/${blog.slug}/`),
};
---

<BaseLayout
    home={false}
    title={blog.title}
    description={description}
    image={image}
    type="article"
    jsonLd={jsonLd}
>

    <div class="relative flex h-min min-h-screen w-auto flex-col flex-nowrap content-center items-center justify-start gap-0 overflow-x-hidden bg-bg p-0">
        <div class="site-root contents min-h-screen w-auto">
            <main class="relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-center gap-20 bg-bg p-0 max-narrow:gap-[50px]">
                <BlogPage blog={blog} />
                <SectionBlogs slug={true} limit={true} current={blog} />
            </main>
        </div>
        <Footer />
    </div>
</BaseLayout>