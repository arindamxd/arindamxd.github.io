---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPage from "../../components/elements/BlogPage.astro";
import SectionBlogs from "../../components/sections/SectionBlogs.astro";
import Footer from "../../components/Footer.astro";

import { getBlogs } from "../../utils/blogs";
import {
    absoluteUrl,
    breadcrumbJsonLd,
    isoDate,
    siteAuthor,
    siteOrigin,
} from "../../utils/seo";

const { blog } = Astro.props;

export async function getStaticPaths() {
    return getBlogs().map((blog) => ({
        params: { slug: blog.slug },
        props: { blog },
    }));
}

const description = blog.page.intro.paragraph;
const image = blog.page.intro.banner || blog.thumb;
const published = isoDate(blog.date);
const canonicalPath = `/blogs/${blog.slug}/`;
const jsonLd = [
    {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: blog.title,
        description,
        image: {
            "@type": "ImageObject",
            url: absoluteUrl(image),
        },
        datePublished: published,
        dateModified: published,
        inLanguage: "en-US",
        url: absoluteUrl(canonicalPath),
        author: {
            "@type": "Person",
            name: blog.author.name,
            url: siteOrigin + "/",
        },
        publisher: {
            "@type": "Person",
            name: siteAuthor.name,
            url: siteOrigin + "/",
        },
        mainEntityOfPage: {
            "@type": "WebPage",
            "@id": absoluteUrl(canonicalPath),
        },
        isPartOf: {
            "@type": "Blog",
            name: "Developer’s Log",
            url: absoluteUrl("/blogs/"),
        },
    },
    breadcrumbJsonLd([
        { name: "Home", path: "/" },
        { name: "Blog", path: "/blogs/" },
        { name: blog.title, path: canonicalPath },
    ]),
];
---

<BaseLayout
    home={false}
    title={blog.title}
    description={description}
    image={image}
    imageAlt={blog.title}
    type="article"
    publishedTime={published}
    modifiedTime={published}
    jsonLd={jsonLd}
>

    <div class="relative flex h-min min-h-screen w-auto flex-col flex-nowrap content-center items-center justify-start gap-0 overflow-x-hidden bg-bg p-0">
        <div class="site-root contents min-h-screen w-auto">
            <main id="main" class="relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-center gap-20 bg-bg p-0 max-narrow:gap-[50px]">
                <BlogPage blog={blog} />
                <SectionBlogs slug={true} limit={true} current={blog} />
            </main>
        </div>
        <Footer />
    </div>
</BaseLayout>
