---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import PageLoader from "../components/PageLoader.astro";

const author = (await import("../content/author-metadata.json")).default;

// props
const { home = false, title = author.name } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark" data-theme="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <!-- Title -->
        <title>{home ? author.name : `${author.name} | ${title}`}</title>

        <!-- SEO -->
        <meta name="description" content={author.bio} />
        <link rel="canonical" href={author.canonical} />
        <meta name="robots" content="max-image-preview:large" />

        <!-- Favicons -->
        <link rel="icon" href="/assets/resources/favicon.svg" />
        <link rel="apple-touch-icon" href="/assets/resources/favicon.svg" />

        <!-- Color scheme -->
        <meta name="theme-color" content="#171717" />
        <meta name="color-scheme" content="light dark" />

        <!-- Apply saved theme + skip loader after first visit this session -->
        <script is:inline>
            (function () {
                try {
                    var stored = localStorage.getItem('theme');
                    var theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
                    document.documentElement.classList.toggle('dark', theme === 'dark');
                    document.documentElement.setAttribute('data-theme', theme);
                    var meta = document.querySelector('meta[name="theme-color"]');
                    if (meta) meta.setAttribute('content', theme === 'dark' ? '#222222' : '#171717');
                } catch (e) {
                    document.documentElement.classList.add('dark');
                    document.documentElement.setAttribute('data-theme', 'dark');
                }

                var seen = false;
                try {
                    seen = sessionStorage.getItem('page-loader-seen') === '1';
                } catch (e) {}

                if (seen) {
                    document.documentElement.classList.remove('is-loading');
                    document.documentElement.classList.add('is-loaded', 'loader-skip');
                    window.__pageLoaderDone = true;
                } else {
                    document.documentElement.classList.add('is-loading');
                }

                // Keep loader skipped + theme intact across Astro client navigations
                document.addEventListener('astro:before-swap', function (e) {
                    var again = false;
                    try {
                        again = sessionStorage.getItem('page-loader-seen') === '1';
                    } catch (err) {}
                    var theme =
                        document.documentElement.getAttribute('data-theme') === 'light'
                            ? 'light'
                            : 'dark';
                    var docEl = e.newDocument.documentElement;
                    docEl.setAttribute('data-theme', theme);
                    docEl.classList.toggle('dark', theme === 'dark');
                    if (again) {
                        docEl.classList.remove('is-loading');
                        docEl.classList.add('is-loaded', 'loader-skip');
                    }
                });
            })();
        </script>

        <!-- Critical loader shell (before CSS) -->
        <style is:inline>
            html.is-loading, html.is-loading body { overflow: hidden; }
            .page-loader {
                position: fixed; inset: 0; z-index: 9999;
                display: flex; align-items: center; justify-content: center;
                background: #222222; color: #f5f5f5;
            }
            html:not(.dark) .page-loader { background: #ffffff; color: #171717; }
            html.loader-skip .page-loader { display: none !important; }
        </style>

        <!-- Facebook Open Graph -->
        <meta property="og:title" content={home ? author.name : `${author.name} | ${title}`} />
        <meta property="og:description" content={author.bio} />
        <meta property="og:type" content="portfolio" />
        <meta property="og:url" content={author.canonical} />
        <meta property="og:image" content={author.ogImage} />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={author.bio} />
        <meta name="twitter:image" content={author.ogImage} />

        <!-- Preload critical assets -->
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="preload" as="image" href={author.ogImage} />

        <!-- Structured data -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "Person",
                "name": "Arindam Karmakar",
                "url": "https://arindamxd.github.io/",
                "sameAs": [
                    "https://github.com/arindamxd",
                    "https://linkedin.com/in/arindamxd",
                    "https://x.com/arindamxd"
                ],
                "jobTitle": "Mobile App Developer"
            }
        </script>

        <!-- Soft page transitions (Framer 1.11 / 1.2); bottom nav persists via transition:persist -->
        <ClientRouter />

        <!-- Theme toggle -->
        <script src="../scripts/theme.js" />

        <!-- Scramble helpers ([data-scramble] opt-in) + Available for… word cycle -->
        <script src="../scripts/scramble-text.js" />
        <script src="../scripts/available-text.js" />

        <!-- Testimonial slider script -->
        <script src="../scripts/testimonial-slider.js" />

        <!-- Motion: hero appear + scroll reveal + Lenis + count-up -->
        <script src="../scripts/hero-appear.js" />
        <script src="../scripts/reveal.js" />
        <script src="../scripts/smooth-scroll.js" />
        <script src="../scripts/count-up.js" />
    </head>

    <body oncontextmenu="return false;">
        <PageLoader />
        <slot />
    </body>
</html>