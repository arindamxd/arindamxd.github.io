---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import PageLoader from "../components/PageLoader.astro";
import NavBar from "../components/NavBar.astro";
import SvgSprite from "../components/SvgSprite.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import {
    absoluteUrl,
    canonicalFromPathname,
    defaultOgImage,
    homeMetaDescription,
    imageMimeType,
    metaDescription,
    OG_IMAGE_HEIGHT,
    OG_IMAGE_WIDTH,
    pageTitle,
    personJsonLd,
    profilePageJsonLd,
    siteAuthor,
    siteOrigin,
    twitterHandle,
    websiteJsonLd,
} from "../utils/seo";

interface Props {
    home?: boolean;
    /** Short page title (without site name). Ignored when home. */
    title?: string;
    description?: string;
    /** Absolute or site-relative image for OG/Twitter. */
    image?: string;
    /** Open Graph type */
    type?: "website" | "article" | "profile";
    noindex?: boolean;
    /** ISO 8601 — article/project pages */
    publishedTime?: string;
    modifiedTime?: string;
    /** Alt text for the share image (defaults to page title). */
    imageAlt?: string;
    /** Hide floating nav (rare; prefer shared chrome). */
    hideNav?: boolean;
    /** Extra JSON-LD objects (Person/WebSite defaults always included on home). */
    jsonLd?: Record<string, unknown> | Record<string, unknown>[];
    /** Open Graph article section (blogs). */
    section?: string;
    /** Open Graph article tags. */
    tags?: string[];
    /** Same-origin LCP image to preload (hero avatar, article/project banner). */
    preloadImage?: string;
}

const {
    home = false,
    title: pageTitleProp = siteAuthor.name,
    description: descriptionProp,
    image: imageProp,
    type = home ? "website" : "website",
    noindex = false,
    publishedTime,
    modifiedTime,
    imageAlt,
    hideNav = false,
    jsonLd,
    section,
    tags,
    preloadImage,
} = Astro.props as Props;

const fullTitle = pageTitle(pageTitleProp, home);
const description = metaDescription(
    descriptionProp || (home ? homeMetaDescription() : siteAuthor.bio),
);
const canonical = canonicalFromPathname(Astro.url.pathname);
const ogImage = absoluteUrl(imageProp || siteAuthor.ogImage);
const ogAlt = imageAlt || fullTitle;
const ogType = imageMimeType(ogImage);
const isDefaultOg = ogImage === defaultOgImage;
const robots = noindex
    ? "noindex, nofollow"
    : "index, follow, max-image-preview:large";
const twitter = twitterHandle();
const personLd = personJsonLd();
const websiteLd = websiteJsonLd();

const extraLd = jsonLd
    ? Array.isArray(jsonLd)
        ? jsonLd
        : [jsonLd]
    : [];

const structuredData = home
    ? [personLd, websiteLd, profilePageJsonLd(), ...extraLd]
    : [personLd, websiteLd, ...extraLd];
---

<!DOCTYPE html>
<html lang="en-US" class="dark" data-theme="dark" transition:animate="none">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <title>{fullTitle}</title>

        <meta name="description" content={description} />
        <meta name="author" content={siteAuthor.name} />
        <link rel="canonical" href={canonical} />
        <meta name="robots" content={robots} />
        {
            !noindex && (
                <link
                    rel="alternate"
                    type="application/rss+xml"
                    title={`${siteAuthor.name} — Blog`}
                    href={absoluteUrl("/rss.xml")}
                />
            )
        }

        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" type="image/png" sizes="32x32" href="/assets/resources/favicon-32.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/assets/resources/apple-touch-icon.png" />
        <link rel="preload" href="/assets/fonts/Manrope.woff2" as="font" type="font/woff2" crossorigin />
        {
            preloadImage && (
                <link rel="preload" href={preloadImage} as="image" fetchpriority="high" />
            )
        }

        <meta name="theme-color" content="#171717" />
        <meta name="color-scheme" content="light dark" />

        <!-- Apply saved theme + skip loader after first visit this session -->
        <script is:inline>
            (function () {
                if (window.__layoutInlineBoot) return;
                window.__layoutInlineBoot = true;
                try {
                    var stored = localStorage.getItem('theme');
                    var theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
                    document.documentElement.classList.toggle('dark', theme === 'dark');
                    document.documentElement.setAttribute('data-theme', theme);
                    var meta = document.querySelector('meta[name="theme-color"]');
                    if (meta) meta.setAttribute('content', theme === 'dark' ? '#222222' : '#171717');
                } catch (e) {
                    document.documentElement.classList.add('dark');
                    document.documentElement.setAttribute('data-theme', 'dark');
                }

                document.documentElement.classList.add('js-motion');
                var reducedMotion = false;
                try {
                    reducedMotion =
                        window.matchMedia &&
                        window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                } catch (e) {}

                var seen = false;
                try {
                    seen = sessionStorage.getItem('page-loader-seen') === '1';
                } catch (e) {}

                if (seen) {
                    document.documentElement.classList.remove('is-loading');
                    document.documentElement.classList.add('is-loaded', 'loader-skip');
                    window.__pageLoaderDone = true;
                } else {
                    document.documentElement.classList.add('is-loading');
                }

                // Keep loader skipped + theme intact across Astro client navigations
                document.addEventListener('astro:before-swap', function (e) {
                    var again = false;
                    try {
                        again = sessionStorage.getItem('page-loader-seen') === '1';
                    } catch (err) {}
                    var theme =
                        document.documentElement.getAttribute('data-theme') === 'light'
                            ? 'light'
                            : 'dark';
                    var docEl = e.newDocument.documentElement;
                    docEl.setAttribute('data-theme', theme);
                    docEl.classList.toggle('dark', theme === 'dark');
                    if (again) {
                        docEl.classList.remove('is-loading');
                        docEl.classList.add('is-loaded', 'loader-skip');
                    }
                    docEl.classList.add('js-motion');
                    if (!reducedMotion) {
                        docEl.classList.add('is-page-entering');
                    }
                });

                // Manual scroll restore — hide page content until mid-page offset is applied
                // (avoids intro flash). Nav stays visible. Content is NOT opacity-stuck via reveal.
                if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
                try {
                    var raw = sessionStorage.getItem('__restoreScroll');
                    if (raw) {
                        var data = JSON.parse(raw);
                        var path = location.pathname + location.search;
                        if (data && data.path === path && typeof data.y === 'number' && data.y > 0) {
                            window.__restoreScrollY = data.y;
                            document.documentElement.classList.add('scroll-pending');
                        }
                    }
                } catch (err) {}

                // Full load / reload: CSS-hold the enter pose until Motion plays.
                // Mid-page uses `is-page-restore` so the shell stays full height (scrollTo can land).
                var midPageRestore =
                    typeof window.__restoreScrollY === 'number' && window.__restoreScrollY > 0;
                if (!reducedMotion) {
                    document.documentElement.classList.add('is-page-entering');
                    if (midPageRestore) {
                        document.documentElement.classList.add('is-page-restore');
                        // Keep scroll-pending until Motion pins opacity 0 (avoids a visible flash).
                        document.documentElement.classList.add('is-scroll-hold');
                    }
                }

                // If the Motion bundle never binds, uncover so the page is not stuck.
                window.setTimeout(function () {
                    if (window.__pageEnterBound || window.__pageEnterStarted) return;
                    window.__pageEnterStarted = true;
                    document.documentElement.classList.remove(
                        'is-page-leaving',
                        'is-page-entering',
                        'is-page-ready',
                        'is-page-restore',
                        'is-scroll-hold',
                        'scroll-pending',
                    );
                    var stuck = document.querySelector('.page-shell');
                    if (stuck) {
                        stuck.classList.remove('page-shell--from', 'page-shell--in');
                        stuck.style.removeProperty('opacity');
                        stuck.style.removeProperty('transform');
                        stuck.style.removeProperty('translate');
                        stuck.style.removeProperty('filter');
                        stuck.style.removeProperty('will-change');
                    }
                    window.dispatchEvent(new CustomEvent('pageenter:start'));
                }, 2500);

                function saveScroll() {
                    try {
                        var y = window.scrollY || window.pageYOffset || 0;
                        if (window.__lenis && typeof window.__lenis.scroll === 'number') {
                            y = window.__lenis.scroll;
                        }
                        sessionStorage.setItem(
                            '__restoreScroll',
                            JSON.stringify({
                                path: location.pathname + location.search,
                                y: y,
                            }),
                        );
                    } catch (err) {}
                }
                window.addEventListener('pagehide', saveScroll);
                window.addEventListener('visibilitychange', function () {
                    if (document.visibilityState === 'hidden') saveScroll();
                });
                document.addEventListener('astro:before-preparation', saveScroll);

                var scrollSaveTimer = 0;
                window.addEventListener(
                    'scroll',
                    function () {
                        window.clearTimeout(scrollSaveTimer);
                        scrollSaveTimer = window.setTimeout(saveScroll, 120);
                    },
                    { passive: true },
                );

                window.__applyScrollRestore = function (show) {
                    var y = window.__restoreScrollY;
                    if (typeof y === 'number' && y > 0) {
                        window.scrollTo(0, y);
                        if (window.__lenis) {
                            try {
                                window.__lenis.scrollTo(y, { immediate: true });
                            } catch (e) {}
                        }
                    }
                    // Position scroll. Do not lift scroll-pending while `is-scroll-hold`
                    // is set — uncovering visibility before Motion pins opacity 0 flashes content.
                    if (show || !(typeof y === 'number' && y > 0)) {
                        if (!document.documentElement.classList.contains('is-scroll-hold')) {
                            document.documentElement.classList.remove('scroll-pending');
                        }
                        if (!window.__scrollRestoreDone) {
                            window.__scrollRestoreDone = true;
                            window.dispatchEvent(new CustomEvent('scrollrestore:done'));
                        }
                    }
                };

                function whenReady(fn) {
                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', fn, { once: true });
                    } else {
                        fn();
                    }
                }
                whenReady(function () {
                    // Position scroll while still hidden
                    window.__applyScrollRestore(false);
                    requestAnimationFrame(function () {
                        window.__applyScrollRestore(false);
                    });
                });

                window.addEventListener(
                    'load',
                    function () {
                        window.__applyScrollRestore(true);
                    },
                    { once: true },
                );

                // Safety: never leave the page blank
                window.setTimeout(function () {
                    window.__applyScrollRestore(true);
                }, 350);

                document.addEventListener('astro:after-swap', function () {
                    try {
                        sessionStorage.removeItem('__restoreScroll');
                    } catch (err) {}
                    window.__restoreScrollY = 0;
                    window.__scrollRestoreDone = true;
                    document.documentElement.classList.remove('scroll-pending');
                });
            })();
        </script>

        <!-- Critical loader shell (before CSS) -->
        <style is:inline>
            html.is-loading, html.is-loading body { overflow: hidden; }
            /* Mid-page reload: hide content until scroll is restored AND enter opacity is pinned */
            html.scroll-pending .site-root,
            html.scroll-pending footer {
                opacity: 0 !important;
                pointer-events: none !important;
            }
            /* CSS hold until Motion springPage plays (reload + ClientRouter) */
            html.is-page-entering .page-shell {
                opacity: 0;
                transform: translate3d(0, 32px, 0);
                will-change: transform, opacity;
            }
            html.is-page-entering:not(.is-page-restore) .page-shell {
                filter: blur(6px);
                height: 100vh;
                overflow: hidden;
                contain: layout paint;
                isolation: isolate;
                will-change: transform, opacity, filter;
            }
            .page-loader {
                position: fixed; inset: 0; z-index: 9999;
                display: flex; align-items: center; justify-content: center;
                background: #222222; color: #f5f5f5;
                opacity: 1;
            }
            html:not(.dark) .page-loader { background: #ffffff; color: #171717; }
            html.loader-skip .page-loader { display: none !important; }
        </style>

        <!-- Open Graph -->
        <meta property="og:site_name" content={siteAuthor.name} />
        <meta property="og:locale" content="en_US" />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content={type} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:alt" content={ogAlt} />
        <meta property="og:image:type" content={ogType} />
        {
            isDefaultOg && (
                <>
                    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
                    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
                </>
            )
        }
        {publishedTime && <meta property="article:published_time" content={publishedTime} />}
        {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
        {type === "article" && (
            <meta property="article:author" content={`${siteOrigin}/`} />
        )}
        {type === "article" && section && (
            <meta property="article:section" content={section} />
        )}
        {
            type === "article" &&
                tags?.map((tag) => <meta property="article:tag" content={tag} />)
        }

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:image:alt" content={ogAlt} />
        {twitter && <meta name="twitter:site" content={twitter} />}
        {twitter && <meta name="twitter:creator" content={twitter} />}

        <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData.length === 1 ? structuredData[0] : structuredData)} />

        <GoogleAnalytics />

        <!-- SPA swaps; content fade is CSS (page-transition.ts) — native VT snapshots freeze glass + images -->
        <ClientRouter />

        <script src="../scripts/site-client.ts"></script>
    </head>

    <body>
        <a class="skip-link" href="#main">Skip to content</a>
        <!-- Apply restored scroll before content paints (pairs with html.scroll-pending) -->
        <script is:inline>
            (function () {
                if (window.__scriptBoot && window.__scriptBoot['scroll-restore-inline']) return;
                (window.__scriptBoot = window.__scriptBoot || {})['scroll-restore-inline'] = true;
                // Position only — keep scroll-pending until Lenis/load reveals
                if (typeof window.__applyScrollRestore === 'function') {
                    window.__applyScrollRestore(false);
                } else if (typeof window.__restoreScrollY === 'number' && window.__restoreScrollY > 0) {
                    window.scrollTo(0, window.__restoreScrollY);
                }
            })();
        </script>
        <PageLoader />
        {
            !hideNav && (
                /* persist only — view-transition-name (transition:name) breaks backdrop-filter */
                <div class="nav-bar-container" transition:persist="site-nav">
                    <NavBar />
                </div>
            )
        }
        <SvgSprite />
        <div class="page-shell">
            <slot />
        </div>
    </body>
</html>
