---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import PageLoader from "../components/PageLoader.astro";
import {
    absoluteUrl,
    canonicalFromPathname,
    metaDescription,
    pageTitle,
    siteAuthor,
    siteOrigin,
} from "../utils/seo";

interface Props {
    home?: boolean;
    /** Short page title (without site name). Ignored when home. */
    title?: string;
    description?: string;
    /** Absolute or site-relative image for OG/Twitter. */
    image?: string;
    /** Open Graph type */
    type?: "website" | "article" | "profile";
    noindex?: boolean;
    /** Extra JSON-LD objects (Person/WebSite defaults always included on home). */
    jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
    home = false,
    title: pageTitleProp = siteAuthor.name,
    description: descriptionProp,
    image: imageProp,
    type = home ? "website" : "website",
    noindex = false,
    jsonLd,
} = Astro.props as Props;

const fullTitle = pageTitle(pageTitleProp, home);
const description = metaDescription(
    descriptionProp ||
        (home
            ? `${siteAuthor.intro.subTitle} ${siteAuthor.bio}`
            : siteAuthor.bio),
);
const canonical = canonicalFromPathname(Astro.url.pathname);
const ogImage = absoluteUrl(imageProp || siteAuthor.ogImage);
const robots = noindex
    ? "noindex, nofollow"
    : "index, follow, max-image-preview:large";

const personLd = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: siteAuthor.name,
    url: siteOrigin + "/",
    jobTitle: siteAuthor.role,
    description: siteAuthor.bio,
    image: absoluteUrl(siteAuthor.intro.avatar),
    address: {
        "@type": "PostalAddress",
        addressCountry: siteAuthor.location,
    },
    sameAs: [
        ...siteAuthor.intro.social.map((s) => s.url),
        ...siteAuthor.footer.social.map((s) => s.url),
    ].filter((url, i, arr) => arr.indexOf(url) === i),
};

const websiteLd = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteAuthor.name,
    url: siteOrigin + "/",
    description: siteAuthor.intro.subTitle,
    author: { "@type": "Person", name: siteAuthor.name },
};

const extraLd = jsonLd
    ? Array.isArray(jsonLd)
        ? jsonLd
        : [jsonLd]
    : [];

const structuredData = home
    ? [personLd, websiteLd, ...extraLd]
    : extraLd.length
      ? extraLd
      : [personLd];
---

<!DOCTYPE html>
<html lang="en" class="dark" data-theme="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <title>{fullTitle}</title>

        <meta name="description" content={description} />
        <meta name="author" content={siteAuthor.name} />
        <link rel="canonical" href={canonical} />
        <meta name="robots" content={robots} />

        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" type="image/png" sizes="32x32" href="/assets/resources/favicon-32.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/assets/resources/apple-touch-icon.png" />

        <meta name="theme-color" content="#171717" />
        <meta name="color-scheme" content="light dark" />

        <!-- Apply saved theme + skip loader after first visit this session -->
        <script is:inline>
            (function () {
                try {
                    var stored = localStorage.getItem('theme');
                    var theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
                    document.documentElement.classList.toggle('dark', theme === 'dark');
                    document.documentElement.setAttribute('data-theme', theme);
                    var meta = document.querySelector('meta[name="theme-color"]');
                    if (meta) meta.setAttribute('content', theme === 'dark' ? '#222222' : '#171717');
                } catch (e) {
                    document.documentElement.classList.add('dark');
                    document.documentElement.setAttribute('data-theme', 'dark');
                }

                var seen = false;
                try {
                    seen = sessionStorage.getItem('page-loader-seen') === '1';
                } catch (e) {}

                if (seen) {
                    document.documentElement.classList.remove('is-loading');
                    document.documentElement.classList.add('is-loaded', 'loader-skip');
                    window.__pageLoaderDone = true;
                } else {
                    document.documentElement.classList.add('is-loading');
                }

                // Keep loader skipped + theme intact across Astro client navigations
                document.addEventListener('astro:before-swap', function (e) {
                    var again = false;
                    try {
                        again = sessionStorage.getItem('page-loader-seen') === '1';
                    } catch (err) {}
                    var theme =
                        document.documentElement.getAttribute('data-theme') === 'light'
                            ? 'light'
                            : 'dark';
                    var docEl = e.newDocument.documentElement;
                    docEl.setAttribute('data-theme', theme);
                    docEl.classList.toggle('dark', theme === 'dark');
                    if (again) {
                        docEl.classList.remove('is-loading');
                        docEl.classList.add('is-loaded', 'loader-skip');
                    }
                });

                // Manual scroll restore — hide page content until mid-page offset is applied
                // (avoids intro flash). Nav stays visible. Content is NOT opacity-stuck via reveal.
                if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
                try {
                    var raw = sessionStorage.getItem('__restoreScroll');
                    if (raw) {
                        var data = JSON.parse(raw);
                        var path = location.pathname + location.search;
                        if (data && data.path === path && typeof data.y === 'number' && data.y > 0) {
                            window.__restoreScrollY = data.y;
                            document.documentElement.classList.add('scroll-pending');
                        }
                    }
                } catch (err) {}

                function saveScroll() {
                    try {
                        var y = window.scrollY || window.pageYOffset || 0;
                        if (window.__lenis && typeof window.__lenis.scroll === 'number') {
                            y = window.__lenis.scroll;
                        }
                        sessionStorage.setItem(
                            '__restoreScroll',
                            JSON.stringify({
                                path: location.pathname + location.search,
                                y: y,
                            }),
                        );
                    } catch (err) {}
                }
                window.addEventListener('pagehide', saveScroll);
                window.addEventListener('visibilitychange', function () {
                    if (document.visibilityState === 'hidden') saveScroll();
                });
                document.addEventListener('astro:before-preparation', saveScroll);

                var scrollSaveTimer = 0;
                window.addEventListener(
                    'scroll',
                    function () {
                        window.clearTimeout(scrollSaveTimer);
                        scrollSaveTimer = window.setTimeout(saveScroll, 120);
                    },
                    { passive: true },
                );

                window.__applyScrollRestore = function (show) {
                    var y = window.__restoreScrollY;
                    if (typeof y === 'number' && y > 0) {
                        window.scrollTo(0, y);
                        if (window.__lenis) {
                            try {
                                window.__lenis.scrollTo(y, { immediate: true });
                            } catch (e) {}
                        }
                    }
                    // Only uncover content when asked (Lenis ready / load / timeout)
                    // Early calls just position scroll while still hidden.
                    if (show || !(typeof y === 'number' && y > 0)) {
                        document.documentElement.classList.remove('scroll-pending');
                        if (!window.__scrollRestoreDone) {
                            window.__scrollRestoreDone = true;
                            window.dispatchEvent(new CustomEvent('scrollrestore:done'));
                        }
                    }
                };

                function whenReady(fn) {
                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', fn, { once: true });
                    } else {
                        fn();
                    }
                }
                whenReady(function () {
                    // Position scroll while still hidden
                    window.__applyScrollRestore(false);
                    requestAnimationFrame(function () {
                        window.__applyScrollRestore(false);
                    });
                });

                window.addEventListener(
                    'load',
                    function () {
                        window.__applyScrollRestore(true);
                    },
                    { once: true },
                );

                // Safety: never leave the page blank
                window.setTimeout(function () {
                    window.__applyScrollRestore(true);
                }, 350);

                document.addEventListener('astro:after-swap', function () {
                    try {
                        sessionStorage.removeItem('__restoreScroll');
                    } catch (err) {}
                    window.__restoreScrollY = 0;
                    window.__scrollRestoreDone = true;
                    document.documentElement.classList.remove('scroll-pending');
                });
            })();
        </script>

        <!-- Critical loader shell (before CSS) -->
        <style is:inline>
            html.is-loading, html.is-loading body { overflow: hidden; }
            /* Mid-page reload: keep nav, hide page until scrollY is restored (no intro flash) */
            html.scroll-pending .proton-root,
            html.scroll-pending footer {
                visibility: hidden !important;
            }
            .page-loader {
                position: fixed; inset: 0; z-index: 9999;
                display: flex; align-items: center; justify-content: center;
                background: #222222; color: #f5f5f5;
            }
            html:not(.dark) .page-loader { background: #ffffff; color: #171717; }
            html.loader-skip .page-loader { display: none !important; }
        </style>

        <!-- Open Graph -->
        <meta property="og:site_name" content={siteAuthor.name} />
        <meta property="og:locale" content="en_US" />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content={type} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:alt" content={fullTitle} />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:image:alt" content={fullTitle} />

        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

        <script type="application/ld+json" set:html={JSON.stringify(structuredData.length === 1 ? structuredData[0] : structuredData)} />

        <!-- Soft page transitions; bottom nav persists via transition:persist -->
        <ClientRouter />

        <!-- Theme toggle -->
        <script src="../scripts/theme.js" />

        <!-- Scramble helpers ([data-scramble] opt-in) + Available for… word cycle -->
        <script src="../scripts/scramble-text.js" />
        <script src="../scripts/available-text.js" />

        <!-- Testimonial slider script -->
        <script src="../scripts/testimonial-slider.js" />

        <!-- Motion: hero appear + scroll reveal + Lenis + count-up -->
        <script src="../scripts/hero-appear.js" />
        <script src="../scripts/reveal.js" />
        <script src="../scripts/smooth-scroll.js" />
        <script src="../scripts/count-up.js" />
    </head>

    <body oncontextmenu="return false;">
        <!-- Apply restored scroll before content paints (pairs with html.scroll-pending) -->
        <script is:inline>
            (function () {
                // Position only — keep scroll-pending until Lenis/load reveals
                if (typeof window.__applyScrollRestore === 'function') {
                    window.__applyScrollRestore(false);
                } else if (typeof window.__restoreScrollY === 'number' && window.__restoreScrollY > 0) {
                    window.scrollTo(0, window.__restoreScrollY);
                }
            })();
        </script>
        <PageLoader />
        <slot />
    </body>
</html>
