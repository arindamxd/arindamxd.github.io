---
const author = (await import("../content/author-metadata.json")).default;
const firstName = author.name.split(/\s+/)[0] ?? author.name;
---

<div
    id="page-loader"
    class="page-loader"
    role="status"
    aria-live="polite"
    aria-busy="true"
    aria-label="Loading"
>
    <div class="page-loader-inner">
        <div class="page-loader-meta">
            <span class="page-loader-dot" aria-hidden="true"></span>
            <p class="page-loader-role">{author.role}</p>
        </div>

        <p class="page-loader-name">{firstName}</p>

        <div class="page-loader-track" aria-hidden="true">
            <div class="page-loader-bar"></div>
        </div>
    </div>
</div>

<!-- Inline: must run immediately (Astro module scripts were not loading this file) -->
<script is:inline>
    (function () {
        if (window.__pageLoaderScript) return;
        window.__pageLoaderScript = true;
        var loader = document.getElementById('page-loader');

        function markSeen() {
            try {
                sessionStorage.setItem('page-loader-seen', '1');
            } catch (e) {}
        }

        function unlockMotion() {
            document.documentElement.classList.remove('is-loading');
            document.documentElement.classList.add('is-loaded');
            window.__pageLoaderDone = true;
            window.dispatchEvent(new CustomEvent('pageloader:done'));
        }

        // Already shown this session — skip immediately (no flash; head set loader-skip)
        var seen = false;
        try {
            seen = sessionStorage.getItem('page-loader-seen') === '1';
        } catch (e) {}

        if (seen || document.documentElement.classList.contains('loader-skip')) {
            if (loader && loader.parentNode) loader.remove();
            unlockMotion();
            return;
        }

        if (!loader) {
            markSeen();
            unlockMotion();
            return;
        }

        var reduced =
            window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        var MIN_MS = reduced ? 0 : 450;
        var MAX_MS = 2500;
        var FONT_WAIT_MS = 800;
        var finished = false;

        document.documentElement.classList.add('is-loading');
        document.documentElement.classList.remove('is-loaded');

        function dismiss() {
            if (finished) return;
            finished = true;
            markSeen();
            loader.setAttribute('aria-busy', 'false');

            if (reduced) {
                loader.remove();
                unlockMotion();
                return;
            }

            loader.classList.add('is-exiting');
            window.setTimeout(unlockMotion, 40);

            var cleaned = false;
            function cleanup() {
                if (cleaned) return;
                cleaned = true;
                loader.removeEventListener('transitionend', onEnd);
                if (loader.parentNode) loader.remove();
            }
            function onEnd(ev) {
                if (ev.target !== loader) return;
                cleanup();
            }
            loader.addEventListener('transitionend', onEnd);
            window.setTimeout(cleanup, 500);
        }

        function whenReady() {
            var minDone = MIN_MS <= 0;
            var docDone = document.readyState !== 'loading';
            var fontsDone = !(document.fonts && document.fonts.ready);
            var settled = false;

            function tryDismiss() {
                if (settled) return;
                if (docDone && fontsDone && minDone) {
                    settled = true;
                    dismiss();
                }
            }

            if (!docDone) {
                document.addEventListener(
                    'DOMContentLoaded',
                    function () {
                        docDone = true;
                        tryDismiss();
                    },
                    { once: true },
                );
            }

            if (document.fonts && document.fonts.ready) {
                var fontTimer = window.setTimeout(function () {
                    fontsDone = true;
                    tryDismiss();
                }, FONT_WAIT_MS);
                document.fonts.ready.then(function () {
                    window.clearTimeout(fontTimer);
                    fontsDone = true;
                    tryDismiss();
                });
            }

            window.setTimeout(function () {
                minDone = true;
                tryDismiss();
            }, MIN_MS);

            // Hard cap so a hung font or parse cannot trap the overlay forever
            window.setTimeout(function () {
                docDone = true;
                fontsDone = true;
                minDone = true;
                tryDismiss();
            }, MAX_MS);
        }

        whenReady();
    })();
</script>
