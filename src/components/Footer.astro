---
// data
const author = (await import("../content/author-metadata.json")).default;

const currentYear = new Date().getFullYear();
---

<footer
    class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-[50px] overflow-visible bg-bg py-[100px] max-framer:px-2.5 max-framer:pt-[60px] max-framer:pb-[50px]"
>
    <div
        class="relative flex h-min w-full max-w-[550px] flex-col flex-nowrap items-center justify-start gap-0 rounded-[46px] border border-[#e8e8e8] bg-surface px-2.5 pt-2.5 pb-0"
    >
        <div
            class="relative flex h-min w-full flex-col flex-nowrap items-center justify-center gap-10 overflow-visible rounded-[40px] bg-bg p-[45px] max-framer:gap-[30px] max-framer:p-10"
        >
            <div
                class="relative flex h-min w-full flex-col flex-nowrap items-center justify-start gap-7 overflow-visible p-0"
            >
                <div
                    class="relative flex h-auto w-full flex-none shrink-0 flex-col justify-start wrap-break-word whitespace-pre-wrap outline-none"
                    style="--proton-paragraph-spacing: 0px"
                >
                    <h2 class="m-0 p-0 font-manrope text-[50px] font-semibold leading-[110%] tracking-[-0.05em] text-center text-text no-underline max-framer:text-[34px]">{author.footer.title}</h2>
                </div>
                <div
                    class="relative flex h-auto w-full max-w-[277px] flex-none shrink-0 flex-col justify-start wrap-break-word whitespace-pre-wrap opacity-60 outline-none"
                    style="--proton-paragraph-spacing: 0px"
                >
                    <p class="m-0 p-0 font-manrope text-[17px] font-semibold leading-[140%] tracking-[-0.04em] text-text no-underline max-framer:text-[15px] text-center">
                        {author.footer.description}
                    </p>
                </div>
            </div>

            <div
                class="relative flex h-min w-[77%] flex-row flex-nowrap items-center justify-center gap-2.5 overflow-visible p-0"
            >
                {
                    author.footer.social.map((link) => (
                        <div class="relative size-10 flex-none">
                            <a
                                aria-label={link.name}
                                class="group/social relative flex size-full cursor-pointer flex-col content-center items-center justify-center rounded-full bg-surface p-2 no-underline"
                                href={link.url}
                                target="_blank"
                                rel="noopener"
                            >
                                <div class="relative h-px w-full flex-1 opacity-40 transition-opacity duration-500 group-hover/social:opacity-100">
                                    <div class="absolute inset-0 rounded-[inherit]">
                                        <img
                                            decoding="async"
                                            width="18"
                                            height="18"
                                            src={link.icon}
                                            alt=""
                                            class="block size-full rounded-[inherit] object-cover object-center"
                                        />
                                    </div>
                                </div>
                            </a>
                        </div>
                    ))
                }
            </div>

            <div
                class="relative flex h-min w-full flex-col flex-nowrap items-center justify-start gap-[22px] overflow-visible p-0"
            >
                <div
                    class="relative flex h-auto w-full flex-none shrink-0 flex-col justify-start wrap-break-word whitespace-pre-wrap opacity-60 outline-none"
                    style="--proton-paragraph-spacing: 0px"
                >
                    <p class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-text no-underline max-framer:text-[13px] text-center">
                        &copy; <b>{currentYear}</b> / All rights Reserved.
                    </p>
                </div>
            </div>
        </div>

        <div class="relative flex h-[64px] w-full flex-none items-center justify-center">
            <a
                class="relative inline-flex items-center gap-1.5 no-underline"
                href="/"
                rel="noopener"
            >
                <span
                    class="font-manrope text-[13px] font-semibold leading-[1.4] tracking-[-0.04em] text-text opacity-60"
                >
                    Created by
                </span>
                <img
                    decoding="async"
                    loading="lazy"
                    src={author.footer.avatar}
                    alt=""
                    class="size-7 rounded-full object-cover object-center"
                />
                <span
                    class="font-manrope text-[13px] font-semibold leading-[1.4] tracking-[-0.04em] text-text"
                >
                    {author.name}
                </span>
            </a>
        </div>
    </div>
</footer>
