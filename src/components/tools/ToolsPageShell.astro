---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../Footer.astro";
import "../../styles/tools.css";

interface Props {
    title: string;
    description: string;
    /** When set, shows a back link to the tools hub */
    showBack?: boolean;
    /** Wider main column for split-pane tools */
    wide?: boolean;
    /** Match footer contact width (550px) — tools hub */
    narrow?: boolean;
}

const { title, description, showBack = false, wide = false, narrow = false } = Astro.props;
const mainMax = wide ? "max-w-[1280px]" : narrow ? "max-w-[550px]" : "max-w-[1100px]";
---

<BaseLayout home={false} title={title} noindex={true} description={description}>
    <div class="relative flex h-min min-h-screen w-auto flex-col flex-nowrap content-center items-center justify-start gap-0 overflow-x-hidden bg-bg p-0">
        <div class="site-root contents min-h-screen w-auto">
            <main
                class:list={[
                    "relative mx-auto flex h-min w-full flex-none flex-col flex-nowrap content-center items-stretch justify-start gap-10 bg-bg pb-24 pt-[120px] max-narrow:gap-8 max-narrow:pt-[100px]",
                    mainMax,
                    narrow ? "px-2.5" : "px-5 max-narrow:px-4",
                ]}
            >
                <header class="flex w-full flex-col gap-8">
                    {
                        showBack && (
                            <div class="relative h-auto w-auto flex-none">
                                <a
                                    data-scramble
                                    data-scramble-variant="primary"
                                    class="group relative flex h-min w-min cursor-pointer flex-row flex-nowrap items-center justify-center gap-4 overflow-visible no-underline"
                                    href="/tools"
                                >
                                    <div class="relative flex size-[52px] flex-none items-center justify-center rounded-full bg-bg shadow-[inset_0_0_0_1px_var(--color-border)] transition-colors duration-200 ease-in-out group-hover:bg-primary">
                                        <div
                                            class="relative h-[14px] w-[15px] flex-none transition-[filter] duration-200 ease-in-out group-hover:brightness-0 group-hover:invert"
                                            style="image-rendering: pixelated;"
                                            aria-hidden="true"
                                        >
                                            <div class="aspect-square size-full">
                                                <svg class="size-full"><use href="#svg12261373696"></use></svg>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="relative h-auto w-auto flex-none whitespace-pre">
                                        <p class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-left text-text max-narrow:text-[13px]">
                                            Back to tools
                                        </p>
                                    </div>
                                </a>
                            </div>
                        )
                    }
                    <div class="flex w-full flex-col gap-3">
                        <h1 class="m-0 font-manrope text-[50px] font-semibold leading-[110%] tracking-[-0.05em] text-text max-narrow:text-[34px]">
                            {title}
                        </h1>
                        <p
                            class:list={[
                                "m-0 font-manrope text-[17px] font-semibold leading-[140%] tracking-[-0.04em] text-text/60 max-narrow:text-[15px]",
                                narrow ? "w-full" : "max-w-[560px]",
                            ]}
                        >
                            <slot name="description">{description}</slot>
                        </p>
                    </div>
                </header>

                <slot />
            </main>
        </div>

        <Footer />
    </div>

    {
        showBack && (
            <div
                id="svg-templates"
                style="position: absolute; overflow: hidden; bottom: 0; left: 0; width: 0; height: 0; z-index: 0; contain: strict"
                aria-hidden="true"
            >
                <svg viewBox="0 0 15 14" id="svg12261373696">
                    <path
                        d="M 4.114 6.168 L 14.239 6.168 L 14.239 7.832 L 4.114 7.832 L 8.576 12.294 L 7.399 13.47 L 0.929 7 L 7.399 0.529 L 8.576 1.706 Z"
                        fill="var(--color-text)"
                    ></path>
                </svg>
            </div>
        )
    }
</BaseLayout>
