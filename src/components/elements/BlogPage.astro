---
import { formatDate } from "../../utils/date";

// props
const { blog } = Astro.props;
---

<article class="relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-center gap-12 overflow-hidden p-0 pt-[110px] pb-[120px] max-framer:gap-8">

    <!-- Article Top -->
    <div class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-start items-start justify-center gap-[34px] overflow-hidden p-0 max-framer:gap-[30px] max-framer:px-5">
        
        <!-- Article Header -->
        <div class="relative flex h-min w-full flex-none flex-col flex-nowrap content-start items-start justify-center gap-10 overflow-hidden p-0 max-framer:gap-[30px]">

            <!-- Back Button -->
            <div class="relative h-auto w-auto flex-none">
                <a class="group relative flex h-min w-min cursor-pointer flex-row flex-nowrap items-center justify-center gap-4 overflow-visible no-underline" href="/blogs">
                    <div class="relative flex size-[52px] flex-none items-center justify-center rounded-full bg-bg shadow-[inset_0_0_0_1px_var(--color-border)] transition-colors duration-200 ease-in-out group-hover:bg-primary">
                        <div class="relative h-[14px] w-[15px] flex-none transition-[filter] duration-200 ease-in-out group-hover:brightness-0 group-hover:invert" style="image-rendering: pixelated;" aria-hidden="true">
                            <div class="aspect-square size-full">
                                <svg class="size-full"><use href="#svg12261373696"></use></svg>
                            </div>
                        </div>
                    </div>
                    <div class="relative h-auto w-auto flex-none whitespace-pre">
                        <p class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-left text-text max-framer:text-[13px]">Back to articles</p>
                    </div>
                </a>
            </div>

            <!-- Article Info -->
            <div
                class="relative flex h-min w-full flex-none flex-col flex-nowrap content-start items-start justify-start gap-7 overflow-visible pt-0 pr-0 pb-8 pl-0 shadow-[inset_0_-1px_0_0_var(--color-border)]"
            >
                <div class="relative h-auto w-full flex-none text-balance">
                    <h1 class="m-0 p-0 font-manrope text-[50px] font-semibold leading-none tracking-[-0.05em] text-left text-text max-framer:text-[34px]">{blog.title}</h1>
                </div>
                <div class="relative flex h-min w-full flex-none flex-row flex-nowrap content-center items-center justify-start gap-[22px] overflow-visible p-0 max-framer:gap-[26px]">
                    <div class="relative flex h-min w-min flex-none flex-row flex-nowrap content-center items-center justify-start gap-2.5 overflow-visible p-0">
                        <div class="relative aspect-square h-7 w-7 flex-none rounded-full">
                            <div class="absolute inset-0" style="border-radius:inherit;">
                                <img decoding="auto" loading="lazy" src={blog.author.avatar} alt="" style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:cover;">
                            </div>
                        </div>
                        <div class="relative h-auto w-auto flex-none whitespace-pre">
                            <p class="m-0 p-0 font-manrope text-[15px] font-semibold leading-none tracking-[-0.05em] text-left text-text whitespace-pre max-framer:text-[14px]">{blog.author.name}</p>
                        </div>
                    </div>
                    <div class="relative h-auto w-auto flex-none whitespace-pre opacity-50 max-framer:order-1">
                        <p class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-text no-underline max-framer:text-[13px]">{formatDate(blog.date, "long")}</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- Article Intro -->
        <div class="relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-center gap-1 overflow-hidden p-0">
            <div class="relative h-auto w-full flex-none whitespace-pre-wrap break-words">
                <p class="m-0 p-0 font-manrope text-[26px] font-semibold leading-[125%] tracking-[-0.04em] text-left text-text max-framer:text-[24px]">{blog.page.intro.title}</p>
            </div>
            <div class="relative h-auto w-full flex-none whitespace-pre-wrap break-words opacity-60">
                <p class="m-0 p-0 font-manrope text-[18px] font-semibold leading-[155%] tracking-[-0.04em] text-left text-text max-framer:text-[16px]">{blog.page.intro.paragraph}</p>
            </div>
        </div>

    </div>

    <!-- Article Image -->
    <div class="relative flex h-min w-full max-w-[1180px] flex-none flex-row flex-nowrap content-center items-center justify-center gap-2.5 overflow-hidden px-[30px] py-0 max-framer:px-2.5">
        <div class="relative aspect-[1.6290322580645162] h-auto max-h-none w-px max-w-[1180px] flex-1 overflow-hidden rounded-[30px] max-framer:rounded-[20px]">
            <div class="absolute inset-0" style="border-radius:inherit;">
                <img decoding="auto" loading="lazy" src={blog.page.intro.banner} alt="" style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:cover;">
            </div>
        </div>
    </div>

    <!-- Article Content -->
    <div class="relative flex h-min w-full max-w-[550px] flex-none flex-row flex-nowrap content-center items-center justify-center gap-2.5 overflow-hidden p-0 max-framer:gap-[30px] max-framer:px-5">
        <div class="article-content relative h-auto w-px max-w-[550px] flex-1 whitespace-pre-wrap break-words">
            {blog.page.body.map((block: { title: string; subtitle: string; paragraph: string; bullets: string[]; }) => (
                <>
                    {block.title && (
                        <h2 class="mt-10 mb-0 p-0 font-manrope text-[38px] font-semibold leading-[125%] tracking-[-0.05em] text-left text-text first:mt-0 max-framer:text-[30px]">{block.title}</h2>
                    )}
                    {block.subtitle && (
                        <h3 class="mt-10 mb-0 p-0 font-manrope text-[22px] font-semibold leading-[140%] tracking-[-0.04em] text-left text-text first:mt-0 max-framer:mt-6 max-framer:text-[20px]">{block.subtitle}</h3>
                    )}
                    {block.paragraph && (
                        <p class="mt-1 mb-0 p-0 font-manrope text-[18px] font-semibold leading-[155%] tracking-[-0.04em] text-left text-text/50 first:mt-0 max-framer:mt-1 max-framer:text-[16px]">{block.paragraph}</p>
                    )}
                    {block.bullets && (
                        <ul class="mt-1 mb-0 flex flex-col gap-5 pl-[1.35em] first:mt-0 max-framer:mt-1 max-framer:gap-3.5">
                            {block.bullets.map((bullet: string) => (
                                <li class="m-0 font-manrope text-[18px] font-semibold leading-[155%] tracking-[-0.04em] text-left text-text/50 max-framer:text-[16px]">
                                    <p class="m-0 p-0 font-manrope text-[18px] font-semibold leading-[155%] tracking-[-0.04em] text-left text-text/50 max-framer:text-[16px]">{bullet}</p>
                                </li>
                            ))}
                        </ul>
                    )}
                </>
            ))}
        </div>
    </div>

</article>
