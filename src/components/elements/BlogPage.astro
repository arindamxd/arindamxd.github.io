---
import { formatDate } from "../../utils/date";

// props
const { blog } = Astro.props;
---

<article class="article" style="padding: 110px 0 0;">

    <!-- Article Top -->
    <div class="article-top-container">
        
        <!-- Article Header -->
        <div class="article-header">

            <!-- Back Button -->
            <div class="back-button-container">
                <a class="back-button-link back-button-link-text display-block" href="/blogs">
                    <div class="back-arrow" data-border="true" style="--border-bottom-width: 1px; --border-color: rgb(233, 233, 233); --border-left-width: 1px; --border-right-width: 1px; --border-style: solid; --border-top-width: 1px; background-color: rgb(255, 255, 255); border-radius: 100%; opacity: 1;">
                        <div class="back-arrow-vector" style="image-rendering: pixelated; flex-shrink: 0; opacity: 1;" aria-hidden="true">
                            <div class="svgContainer" style="width:100%;height:100%;aspect-ratio:inherit">
                                <svg style="width:100%;height:100%;"><use href="#svg12261373696"></use></svg>
                            </div>
                        </div>
                    </div>
                    <div class="back-button-text" style="outline: none; display: flex; flex-direction: column; justify-content: flex-start; flex-shrink: 0; --proton-paragraph-spacing: 0px; transform: none; opacity: 1;">
                        <p class="proton-text proton-styles-preset-back-button-text" style="--proton-text-alignment:left">Back to articles</p>
                    </div>
                </a>
            </div>

            <!-- Article Info -->
            <div class="article-info-container" data-border="true">
                <div class="article-info-title" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none">
                    <h1 class="proton-text proton-styles-preset-article-title">{blog.title}</h1>
                </div>
                <div class="article-info">
                    <div class="article-info-author">
                        <div class="article-info-author-avatar">
                            <div style="position:absolute;border-radius:inherit;top:0;right:0;bottom:0;left:0">
                                <img decoding="auto" loading="lazy" src={blog.author.avatar} alt="" style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:cover;">
                            </div>
                        </div>
                        <div class="article-info-author-name" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none">
                            <p class="proton-text proton-styles-preset-nav-menu-item" style="--proton-text-alignment:left;--proton-text-color:var(--color-text)">{blog.author.name}</p>
                        </div>
                    </div>
                    <div class="article-info-date" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none;">
                        <p class="proton-text proton-styles-preset-role">{formatDate(blog.date, "long")}</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- Article Intro -->
        <div class="article-intro-container">
            <div class="article-intro" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none;">
                <p class="proton-text proton-styles-preset-article-intro">{blog.page.intro.title}</p>
            </div>
            <div class="article-intro-description" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none;">
                <p class="proton-text proton-styles-preset-past-year">{blog.page.intro.paragraph}</p>
            </div>
        </div>

    </div>

    <!-- Article Image -->
    <div class="article-image-container" style="will-change: transform; opacity: 1; transform: none;">
        <div class="article-image">
            <div style="position:absolute;border-radius:inherit;top:0;right:0;bottom:0;left:0;">
                <img decoding="auto" loading="lazy" src={blog.page.intro.banner} alt="" style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:cover;">
            </div>
        </div>
    </div>

    <!-- Article Content -->
    <div class="article-content-container">
        <div class="article-content" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none;">
            {blog.page.body.map((block: { title: string; subtitle: string; paragraph: string; bullets: string[]; }) => (
                <>
                    {block.title && (
                        <h2 class="proton-text proton-styles-preset-article-h2">{block.title}</h2>
                    )}
                    {block.subtitle && (
                        <h3 class="proton-text proton-styles-preset-article-h3">{block.subtitle}</h3>
                    )}
                    {block.paragraph && (
                        <p class="proton-text proton-styles-preset-article-p">{block.paragraph}</p>
                    )}
                    {block.bullets && (
                        <ul class="proton-text">
                            {block.bullets.map((bullet: string) => (
                                <>
                                    <li class="proton-text proton-styles-preset-article-p"><p class="proton-text proton-styles-preset-article-p">{bullet}</p></li>
                                </>
                            ))}
                        </ul>
                    )}
                </>
            ))}
        </div>
    </div>

</article>