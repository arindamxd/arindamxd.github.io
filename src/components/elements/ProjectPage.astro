---
import { formatDate } from "../../utils/date";

// props
const { project } = Astro.props;

// project data
const { header, body } = project.page;
---

<article class="relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-start gap-12 p-0 max-framer:gap-8">
    <div class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-12 overflow-visible p-0 max-framer:gap-10 max-framer:px-5">

        <div class="hero-tie-container" style="opacity: 1; transform: translateX(-50%); will-change: transform;">
            <div class="hero-tie hero-tie-centered">
                <div class="hero-tie-stripe" />
                <div class="hero-tie-holder" style="background-color: rgb(23, 23, 23); border-radius: 6px; opacity: 1;"></div>
                <div class="hero-tie-box" style="background: linear-gradient(rgb(7, 7, 7) 0%, rgb(45, 45, 45) 100%); border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; opacity: 1;"></div>
            </div>
        </div>

        <div class="hero-badge">
            <div class="hero-card shadow-[inset_0_0_0_1px_var(--color-border)]" id="hero">
                <div class="hero-card-hole shadow-[inset_0_0_0_1px_var(--color-border)]"></div>

                <!-- Project Image -->
                <div class="relative flex h-min w-full flex-none flex-row flex-nowrap content-center items-center justify-center gap-2.5 overflow-hidden rounded-[40px] p-0 will-change-transform max-framer:rounded-[30px]">
                    <div class="relative aspect-[1.4627659574468086] h-auto w-px flex-1 overflow-hidden max-framer:rounded-[30px]">
                        <div class="absolute inset-0" style="border-radius:inherit;">
                            <img decoding="auto" loading="lazy" src={project.images.banner} alt="" style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:cover">
                        </div>
                    </div>
                </div>

                <!-- Organization -->
                {header.organization && (
                    <div class="relative h-auto w-full flex-none">
                        <div class="relative flex h-[74px] w-full flex-row flex-nowrap items-center justify-start gap-5 overflow-hidden rounded-[41px] bg-bg py-2.5 pr-5 pl-2.5">
                            <div class="relative flex h-full w-px min-w-0 flex-1 flex-row flex-nowrap items-center justify-start gap-4 overflow-hidden p-0">
                                <div class="relative flex h-[54px] w-[54px] flex-none flex-row flex-nowrap items-center justify-center rounded-[50px] bg-surface p-0">
                                    <div class="relative h-[22px] w-[22px] flex-none">
                                        <div style="display:contents">
                                            <img decoding="auto" src="/assets/resources/organization.svg" alt="" class="dark:brightness-0 dark:invert">
                                        </div>
                                    </div>
                                </div>
                                <div class="relative min-w-0 flex-1 opacity-50">
                                    <p class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-left text-text max-framer:text-[13px]">Organization</p>
                                </div>
                            </div>
                            <div class="relative flex h-full w-px min-w-0 flex-1 flex-row flex-nowrap items-center justify-end overflow-hidden p-0">
                                <p class="m-0 min-w-0 flex-1 p-0 font-manrope text-[16px] font-semibold leading-[130%] tracking-[-0.04em] break-words text-right text-text max-framer:text-[14px]">{header.organization}</p>
                            </div>
                        </div>
                    </div>
                )}

                <!-- Category -->
                {header.category && (
                    <div class="relative h-auto w-full flex-none">
                        <div class="relative flex h-[74px] w-full flex-row flex-nowrap items-center justify-start gap-5 overflow-hidden rounded-[41px] bg-bg py-2.5 pr-5 pl-2.5">
                            <div class="relative flex h-full w-px min-w-0 flex-1 flex-row flex-nowrap items-center justify-start gap-4 overflow-hidden p-0">
                                <div class="relative flex h-[54px] w-[54px] flex-none flex-row flex-nowrap items-center justify-center rounded-[50px] bg-surface p-0">
                                    <div class="relative h-[22px] w-[22px] flex-none">
                                        <div style="display:contents">
                                            <img decoding="auto" src="/assets/resources/category.svg" alt="" class="dark:brightness-0 dark:invert">
                                        </div>
                                    </div>
                                </div>
                                <div class="relative min-w-0 flex-1 opacity-50">
                                    <p class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-left text-text max-framer:text-[13px]">Category</p>
                                </div>
                            </div>
                            <div class="relative flex h-full w-px min-w-0 flex-1 flex-row flex-nowrap items-center justify-end overflow-hidden p-0">
                                <p class="m-0 min-w-0 flex-1 p-0 font-manrope text-[16px] font-semibold leading-[130%] tracking-[-0.04em] break-words text-right text-text max-framer:text-[14px]">{header.category}</p>
                            </div>
                        </div>
                    </div>
                )}

                <!-- Released on -->
                {header.released_date && (
                    <div class="relative h-auto w-full flex-none">
                        <div class="relative flex h-[74px] w-full flex-row flex-nowrap items-center justify-start gap-5 overflow-hidden rounded-[41px] bg-bg py-2.5 pr-5 pl-2.5">
                            <div class="relative flex h-full w-px min-w-0 flex-1 flex-row flex-nowrap items-center justify-start gap-4 overflow-hidden p-0">
                                <div class="relative flex h-[54px] w-[54px] flex-none flex-row flex-nowrap items-center justify-center rounded-[50px] bg-surface p-0">
                                    <div class="relative h-[22px] w-[22px] flex-none">
                                        <div style="display:contents">
                                            <img decoding="auto" src="/assets/resources/date.svg" alt="" class="dark:brightness-0 dark:invert">
                                        </div>
                                    </div>
                                </div>
                                <div class="relative min-w-0 flex-1 opacity-50">
                                    <p class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-left text-text max-framer:text-[13px]">Released on</p>
                                </div>
                            </div>
                            <div class="relative flex h-full w-px min-w-0 flex-1 flex-row flex-nowrap items-center justify-end overflow-hidden p-0">
                                <p class="m-0 min-w-0 flex-1 p-0 font-manrope text-[16px] font-semibold leading-[130%] tracking-[-0.04em] break-words text-right text-text max-framer:text-[14px]">{formatDate(header.released_date, 'long')}</p>
                            </div>
                        </div>
                    </div>
                )}

                <!-- Website Link -->
                {header.link && (
                    <div class="hero-card-bottom hero-card-bottom--project">
                        <div class="relative h-auto w-auto flex-none">
                            <a class="group relative flex h-min w-min cursor-pointer flex-row flex-nowrap items-center justify-start gap-[7px] overflow-visible py-0 no-underline" href={header.link} target="_blank" rel="noopener">
                                <div class="relative h-auto w-auto flex-none whitespace-pre">
                                    <p class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-text no-underline max-framer:text-[13px]">Source Code / Live Preview</p>
                                </div>
                                <div class="relative h-2.5 w-2.5 flex-none transition-transform duration-200 ease-out group-hover:rotate-45">
                                    <svg class="h-full w-full"><use href="#link-arrow"></use></svg>
                                </div>
                            </a>
                        </div>
                    </div>
                )}

            </div>
        </div>

        <!-- Project Header Info -->
        <div class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-start items-start justify-center gap-1 overflow-hidden p-0">
            <div class="relative h-auto w-full flex-none whitespace-pre-wrap break-words max-framer:order-0">
                <h1 class="m-0 p-0 font-manrope text-[50px] font-semibold leading-none tracking-[-0.05em] text-left text-text max-framer:text-[34px]">{project.title}</h1>
            </div>
            <div class="relative h-auto w-full flex-none whitespace-pre-wrap break-words opacity-60 max-framer:order-1">
                <p class="m-0 p-0 font-manrope text-[18px] font-semibold leading-[155%] tracking-[-0.04em] text-left text-text max-framer:text-[16px]">{project.desc.long}</p>
            </div>
            <div class="relative mt-5 h-auto w-auto flex-none max-framer:order-2">
                <a class="group relative flex h-min w-min cursor-pointer flex-row flex-nowrap items-center justify-center gap-[14px] overflow-visible no-underline" href="/projects">
                    <div class="relative flex size-[52px] flex-none items-center justify-center rounded-full bg-bg shadow-[inset_0_0_0_1px_var(--color-border)] transition-colors duration-200 ease-in-out group-hover:bg-primary">
                        <div class="relative h-[14px] w-[15px] flex-none transition-[filter] duration-200 ease-in-out group-hover:brightness-0 group-hover:invert" style="image-rendering: pixelated;" aria-hidden="true">
                            <div class="aspect-square size-full">
                                <svg class="size-full"><use href="#svg12261373696"></use></svg>
                            </div>
                        </div>
                    </div>
                    <div class="relative h-auto w-auto flex-none whitespace-pre">
                        <p class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-left text-text max-framer:text-[13px]">Back to projects</p>
                    </div>
                </a>
            </div>
        </div>

    </div>


    <!-- Project Body -->

    <!-- Image Small Two -->
    <div class="relative flex h-min w-full max-w-[1180px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-2.5 overflow-hidden px-[30px] py-0 max-framer:px-2.5">
        <div class="relative flex h-min w-full flex-none flex-row flex-nowrap content-center items-center justify-center gap-2.5 overflow-hidden p-0 max-framer:flex-col">
            <div class="relative aspect-[1.3295454545454546] h-auto w-px max-w-[1100px] flex-1 overflow-hidden rounded-[30px] max-framer:h-[278px] max-framer:w-full max-framer:flex-none max-framer:aspect-[1.3295454545454546]">
                <div class="absolute inset-0" style="border-radius:inherit;">
                    <img decoding="auto" loading="lazy" src={body.container_top.left_image.src} alt={body.container_top.left_image.alt} style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:cover">
                </div>
            </div>
            <div class="relative aspect-[1.3295454545454546] h-auto w-px max-w-[1100px] flex-1 overflow-hidden rounded-[30px] max-framer:h-[278px] max-framer:w-full max-framer:flex-none max-framer:aspect-[1.3295454545454546]">
                <div class="absolute inset-0" style="border-radius:inherit;">
                    <img decoding="auto" loading="lazy" src={body.container_top.right_image.src} alt={body.container_top.right_image.alt} style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:cover">
                </div>
            </div>
        </div>
    </div>

    <!-- Content First -->
    <div class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-1 overflow-hidden p-0 max-framer:px-5">
        <div class="relative h-auto w-full flex-none whitespace-pre-wrap break-words">
            <p class="m-0 p-0 font-manrope text-[26px] font-semibold leading-[125%] tracking-[-0.04em] text-left text-text max-framer:text-[24px]">{body.container_middle.content.title}</p>
        </div>
        <div class="relative h-auto w-full flex-none whitespace-pre-wrap break-words opacity-60">
            <p class="m-0 p-0 font-manrope text-[18px] font-semibold leading-[155%] tracking-[-0.04em] text-left text-text max-framer:text-[16px]">{body.container_middle.content.description}</p>
        </div>
    </div>

    <!-- Image Single Large -->
    <div class="relative flex h-min w-full max-w-[1180px] flex-none flex-row flex-nowrap content-center items-center justify-center gap-2.5 overflow-hidden px-[30px] py-0 max-framer:px-2.5">
        <div class="relative aspect-[1.463768115942029] h-auto w-px max-w-[1180px] flex-1 overflow-hidden rounded-[30px] max-framer:h-[278px] max-framer:w-full max-framer:flex-none max-framer:aspect-[1.3295454545454546]">
            <div class="absolute inset-0" style="border-radius:inherit;">
                <img decoding="auto" loading="lazy" src={body.container_middle.large_image.src} alt={body.container_middle.large_image.alt} style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:cover">
            </div>
        </div>
    </div>

    <!-- Content Second -->
    <div class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-1 overflow-hidden p-0 max-framer:px-5">
        <div class="relative h-auto w-full flex-none whitespace-pre-wrap break-words">
            <p class="m-0 p-0 font-manrope text-[26px] font-semibold leading-[125%] tracking-[-0.04em] text-left text-text max-framer:text-[24px]">{body.container_bottom.content.title}</p>
        </div>
        <div class="relative h-auto w-full flex-none whitespace-pre-wrap break-words opacity-60">
            <p class="m-0 p-0 font-manrope text-[18px] font-semibold leading-[155%] tracking-[-0.04em] text-left text-text max-framer:text-[16px]">{body.container_bottom.content.description}</p>
        </div>
    </div>

    <!-- Image Small Two + Large One -->
    <div class="relative flex h-min w-full max-w-[1180px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-2.5 overflow-hidden px-[30px] py-0 max-framer:px-2.5">
        <div class="relative flex h-min w-full flex-none flex-row flex-nowrap content-center items-center justify-center gap-2.5 overflow-hidden p-0 max-framer:flex-col">
            <div class="relative aspect-[1.3295454545454546] h-auto w-px max-w-[1100px] flex-1 overflow-hidden rounded-[30px] max-framer:h-[278px] max-framer:w-full max-framer:flex-none max-framer:aspect-[1.3295454545454546]">
                <div class="absolute inset-0" style="border-radius:inherit;">
                    <img decoding="auto" loading="lazy" src={body.container_bottom.left_image.src} alt={body.container_bottom.left_image.alt} style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:cover">
                </div>
            </div>
            <div class="relative aspect-[1.3295454545454546] h-auto w-px max-w-[1100px] flex-1 overflow-hidden rounded-[30px] max-framer:h-[278px] max-framer:w-full max-framer:flex-none max-framer:aspect-[1.3295454545454546]">
                <div class="absolute inset-0" style="border-radius:inherit;">
                    <img decoding="auto" loading="lazy" src={body.container_bottom.right_image.src} alt={body.container_bottom.right_image.alt} style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:cover">
                </div>
            </div>
        </div>
        <div class="relative aspect-[1.463768115942029] h-[376px] w-full max-w-[1180px] flex-none overflow-hidden rounded-[30px] max-framer:h-[278px] max-framer:aspect-[1.3295454545454546]">
            <div class="absolute inset-0" style="border-radius:inherit;">
                <img decoding="auto" loading="lazy" src={body.container_bottom.large_image.src} alt={body.container_bottom.large_image.alt} style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:cover">
            </div>
        </div>
    </div>

</article>
