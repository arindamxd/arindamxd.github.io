---
import { formatDate } from "../../utils/date";
import type { ProjectBodyBlock } from "../../types/project";
import ProjectLightboxImage from "./ProjectLightboxImage.astro";
import ShareBar from "./ShareBar.astro";

// props
const { project } = Astro.props;

// project data
const { header } = project;
const body = project.page.body as ProjectBodyBlock[];
---

<article class="relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-start gap-12 p-0 max-narrow:gap-8">
    <!-- Hero card: intro-matched outside gutter -->
    <div class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-12 overflow-visible p-0 max-narrow:gap-10 max-narrow:px-2.5">

        <div class="hero-tie-container">
            <div class="hero-tie hero-tie-centered">
                <div class="hero-tie-stripe" />
                <div class="hero-tie-holder"></div>
                <div class="hero-tie-box"></div>
            </div>
        </div>

        <div class="hero-badge">
            <div class="hero-card" id="hero">
                <div class="hero-card-hole shadow-[inset_0_0_0_1px_var(--color-border)]"></div>

                <!-- Project Image -->
                <div class="relative flex h-min w-full flex-none flex-row flex-nowrap content-center items-center justify-center gap-2.5 overflow-hidden rounded-[40px] p-0 will-change-transform max-narrow:rounded-[30px]">
                    <div class="relative aspect-[1.4627659574468086] h-auto w-px flex-1 overflow-hidden max-narrow:rounded-[30px]">
                        <div class="absolute inset-0" style="border-radius:inherit;">
                            <img decoding="async" fetchpriority="high" width="550" height="376" sizes="(max-width: 609px) calc(100vw - 20px), 550px" src={project.images.banner} alt={project.title} style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:cover">
                        </div>
                    </div>
                </div>

                <!-- Organization -->
                {header.organization && (
                    <div class="relative h-auto w-full flex-none">
                        <div class="relative flex h-[74px] w-full flex-row flex-nowrap items-center justify-start gap-5 overflow-hidden rounded-[41px] bg-bg py-2.5 pr-5 pl-2.5">
                            <div class="relative flex h-full w-px min-w-0 flex-1 flex-row flex-nowrap items-center justify-start gap-4 overflow-hidden p-0">
                                <div class="relative flex h-[54px] w-[54px] flex-none flex-row flex-nowrap items-center justify-center rounded-[50px] bg-surface p-0">
                                    <div class="relative h-[22px] w-[22px] flex-none">
                                        <div style="display:contents">
                                            <img decoding="async" src="/assets/resources/organization.svg" alt="" class="dark:brightness-0 dark:invert">
                                        </div>
                                    </div>
                                </div>
                                <div class="relative min-w-0 flex-1 opacity-50">
                                    <p class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-left text-text max-narrow:text-[13px]">Organization</p>
                                </div>
                            </div>
                            <div class="relative flex h-full w-px min-w-0 flex-1 flex-row flex-nowrap items-center justify-end overflow-hidden p-0">
                                <p class="m-0 min-w-0 flex-1 p-0 font-manrope text-[16px] font-semibold leading-[130%] tracking-[-0.04em] break-words text-right text-text max-narrow:text-[14px]">{header.organization}</p>
                            </div>
                        </div>
                    </div>
                )}

                <!-- Category -->
                {header.category && (
                    <div class="relative h-auto w-full flex-none">
                        <div class="relative flex h-[74px] w-full flex-row flex-nowrap items-center justify-start gap-5 overflow-hidden rounded-[41px] bg-bg py-2.5 pr-5 pl-2.5">
                            <div class="relative flex h-full w-px min-w-0 flex-1 flex-row flex-nowrap items-center justify-start gap-4 overflow-hidden p-0">
                                <div class="relative flex h-[54px] w-[54px] flex-none flex-row flex-nowrap items-center justify-center rounded-[50px] bg-surface p-0">
                                    <div class="relative h-[22px] w-[22px] flex-none">
                                        <div style="display:contents">
                                            <img decoding="async" src="/assets/resources/category.svg" alt="" class="dark:brightness-0 dark:invert">
                                        </div>
                                    </div>
                                </div>
                                <div class="relative min-w-0 flex-1 opacity-50">
                                    <p class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-left text-text max-narrow:text-[13px]">Category</p>
                                </div>
                            </div>
                            <div class="relative flex h-full w-px min-w-0 flex-1 flex-row flex-nowrap items-center justify-end overflow-hidden p-0">
                                <p class="m-0 min-w-0 flex-1 p-0 font-manrope text-[16px] font-semibold leading-[130%] tracking-[-0.04em] break-words text-right text-text max-narrow:text-[14px]">{header.category}</p>
                            </div>
                        </div>
                    </div>
                )}

                <!-- Released on -->
                {header.released_date && (
                    <div class="relative h-auto w-full flex-none">
                        <div class="relative flex h-[74px] w-full flex-row flex-nowrap items-center justify-start gap-5 overflow-hidden rounded-[41px] bg-bg py-2.5 pr-5 pl-2.5">
                            <div class="relative flex h-full w-px min-w-0 flex-1 flex-row flex-nowrap items-center justify-start gap-4 overflow-hidden p-0">
                                <div class="relative flex h-[54px] w-[54px] flex-none flex-row flex-nowrap items-center justify-center rounded-[50px] bg-surface p-0">
                                    <div class="relative h-[22px] w-[22px] flex-none">
                                        <div style="display:contents">
                                            <img decoding="async" src="/assets/resources/date.svg" alt="" class="dark:brightness-0 dark:invert">
                                        </div>
                                    </div>
                                </div>
                                <div class="relative min-w-0 flex-1 opacity-50">
                                    <p class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-left text-text max-narrow:text-[13px]">Released on</p>
                                </div>
                            </div>
                            <div class="relative flex h-full w-px min-w-0 flex-1 flex-row flex-nowrap items-center justify-end overflow-hidden p-0">
                                <p class="m-0 min-w-0 flex-1 p-0 font-manrope text-[16px] font-semibold leading-[130%] tracking-[-0.04em] break-words text-right text-text max-narrow:text-[14px]">{formatDate(header.released_date, 'long')}</p>
                            </div>
                        </div>
                    </div>
                )}

                <!-- Website Link -->
                {header.link && (
                    <div class="hero-card-bottom hero-card-bottom--project">
                        <div class="relative h-auto w-auto flex-none">
                            <a data-scramble data-scramble-variant="primary" class="group relative flex h-min w-min cursor-pointer flex-row flex-nowrap items-center justify-start gap-[7px] overflow-visible py-0 no-underline" href={header.link} target="_blank" rel="noopener">
                                <div class="relative h-auto w-auto flex-none whitespace-pre">
                                    <p class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-text no-underline max-narrow:text-[13px]">Live Preview</p>
                                </div>
                                <div class="relative h-2.5 w-2.5 flex-none transition-transform duration-200 ease-out group-hover:rotate-45">
                                    <svg class="h-full w-full"><use href="#link-arrow"></use></svg>
                                </div>
                            </a>
                        </div>
                    </div>
                )}

            </div>
        </div>
    </div>

        <!-- Project Header Info — original text gutter -->
        <div class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-start items-start justify-center gap-12 overflow-visible p-0 max-narrow:gap-8 max-narrow:px-5">
            <div class="relative flex h-min w-full flex-none flex-col flex-nowrap content-start items-start justify-center gap-5 overflow-visible p-0">
                <div class="relative h-auto w-full flex-none break-words max-narrow:order-0">
                    <h1 class="m-0 p-0 font-manrope text-[50px] font-semibold leading-[105%] tracking-[-0.05em] text-left text-text max-narrow:text-[34px]">{project.title}</h1>
                </div>
                <div class="relative h-auto w-full flex-none break-words opacity-60 max-narrow:order-1">
                    <p class="m-0 p-0 font-manrope text-[18px] font-semibold leading-[155%] tracking-[-0.04em] text-left text-text max-narrow:text-[16px]">{project.desc.long}</p>
                </div>
            </div>
            <div class="relative flex h-auto w-full flex-none flex-row items-center justify-between gap-4 overflow-visible max-narrow:order-2">
                <a data-scramble data-scramble-variant="primary" class="group relative flex h-min w-min cursor-pointer flex-row flex-nowrap items-center justify-center gap-[14px] overflow-visible no-underline" href="/projects">
                    <div class="relative flex size-[52px] flex-none items-center justify-center rounded-full bg-bg shadow-[inset_0_0_0_1px_var(--color-border)] transition-colors duration-200 ease-in-out group-hover:bg-primary">
                        <div class="relative h-[14px] w-[15px] flex-none transition-[filter] duration-200 ease-in-out group-hover:brightness-0 group-hover:invert" style="image-rendering: pixelated;" aria-hidden="true">
                            <div class="aspect-square size-full">
                                <svg class="size-full"><use href="#svg12261373696"></use></svg>
                            </div>
                        </div>
                    </div>
                    <div class="relative h-auto w-auto flex-none whitespace-pre">
                        <p class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-left text-text max-narrow:text-[13px]">Back to projects</p>
                    </div>
                </a>
                <ShareBar
                    title={project.title}
                    url={`/projects/${project.slug}/`}
                    text={project.desc.short}
                />
            </div>
        </div>


    <!-- Project Body -->
    {body.map((block) => {
        if (block.type === "images-pair") {
            return (
                <div class="relative flex h-min w-full max-w-[1180px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-2.5 overflow-hidden px-[30px] py-0 max-narrow:px-2.5">
                    <div class="relative flex h-min w-full flex-none flex-row flex-nowrap content-center items-center justify-center gap-2.5 overflow-hidden p-0 max-narrow:flex-col">
                        <div class="relative aspect-[1.3295454545454546] h-auto w-px max-w-[1100px] flex-1 overflow-hidden rounded-[30px] max-narrow:h-[278px] max-narrow:w-full max-narrow:flex-none max-narrow:aspect-[1.3295454545454546]">
                            <ProjectLightboxImage src={block.left.src} alt={block.left.alt} />
                        </div>
                        <div class="relative aspect-[1.3295454545454546] h-auto w-px max-w-[1100px] flex-1 overflow-hidden rounded-[30px] max-narrow:h-[278px] max-narrow:w-full max-narrow:flex-none max-narrow:aspect-[1.3295454545454546]">
                            <ProjectLightboxImage src={block.right.src} alt={block.right.alt} />
                        </div>
                    </div>
                </div>
            );
        }

        if (block.type === "content") {
            return (
                <div class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-5 overflow-hidden p-0 max-narrow:px-5">
                    <div class="relative h-auto w-full flex-none break-words">
                        <p class="m-0 p-0 font-manrope text-[26px] font-semibold leading-[115%] tracking-[-0.04em] text-left text-text max-narrow:text-[24px]">{block.title}</p>
                    </div>
                    <div class="relative h-auto w-full flex-none break-words opacity-60">
                        <p class="m-0 p-0 font-manrope text-[18px] font-semibold leading-[155%] tracking-[-0.04em] text-left text-text max-narrow:text-[16px]">{block.description}</p>
                    </div>
                </div>
            );
        }

        if (block.type === "image-large") {
            return (
                <div class="relative flex h-min w-full max-w-[1180px] flex-none flex-row flex-nowrap content-center items-center justify-center gap-2.5 overflow-hidden px-[30px] py-0 max-narrow:px-2.5">
                    <div class="relative aspect-[1.463768115942029] h-auto w-px max-w-[1180px] flex-1 overflow-hidden rounded-[30px] max-narrow:h-[278px] max-narrow:w-full max-narrow:flex-none max-narrow:aspect-[1.3295454545454546]">
                        <ProjectLightboxImage src={block.image.src} alt={block.image.alt} />
                    </div>
                </div>
            );
        }

        if (block.type === "images-pair-then-large") {
            return (
                <div class="relative flex h-min w-full max-w-[1180px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-2.5 overflow-hidden px-[30px] py-0 max-narrow:px-2.5">
                    <div class="relative flex h-min w-full flex-none flex-row flex-nowrap content-center items-center justify-center gap-2.5 overflow-hidden p-0 max-narrow:flex-col">
                        <div class="relative aspect-[1.3295454545454546] h-auto w-px max-w-[1100px] flex-1 overflow-hidden rounded-[30px] max-narrow:h-[278px] max-narrow:w-full max-narrow:flex-none max-narrow:aspect-[1.3295454545454546]">
                            <ProjectLightboxImage src={block.left.src} alt={block.left.alt} />
                        </div>
                        <div class="relative aspect-[1.3295454545454546] h-auto w-px max-w-[1100px] flex-1 overflow-hidden rounded-[30px] max-narrow:h-[278px] max-narrow:w-full max-narrow:flex-none max-narrow:aspect-[1.3295454545454546]">
                            <ProjectLightboxImage src={block.right.src} alt={block.right.alt} />
                        </div>
                    </div>
                    <div class="relative aspect-[1.463768115942029] h-[376px] w-full max-w-[1180px] flex-none overflow-hidden rounded-[30px] max-narrow:h-[278px] max-narrow:aspect-[1.3295454545454546]">
                        <ProjectLightboxImage src={block.large.src} alt={block.large.alt} />
                    </div>
                </div>
            );
        }

        return null;
    })}

    <!-- Project links — outside gutter matches footer / intro (px-2.5) -->
    {(project.source_code || project.privacy_policy) && (
        <div class="relative mt-5 w-full max-w-[550px] flex-none max-narrow:mt-2.5 max-narrow:px-2.5">
            <div
                class="relative flex h-[64px] w-full flex-row flex-nowrap content-center items-center justify-evenly rounded-[46px] border border-border bg-surface max-narrow:rounded-[36px]"
            >
                {project.source_code && (
                    <a
                        data-scramble
                        data-scramble-variant="primary"
                        class="group relative flex h-min w-min cursor-pointer flex-row flex-nowrap items-center justify-start gap-[7px] overflow-visible no-underline"
                        href={project.source_code}
                        target="_blank"
                        rel="noopener"
                    >
                        <div class="relative h-auto w-auto flex-none whitespace-pre">
                            <p class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-text no-underline max-narrow:text-[13px]">Source Code</p>
                        </div>
                        <div class="relative h-2.5 w-2.5 flex-none transition-transform duration-200 ease-out group-hover:rotate-45">
                            <svg class="h-full w-full"><use href="#link-arrow"></use></svg>
                        </div>
                    </a>
                )}
                {project.privacy_policy && (
                    <a
                        data-scramble
                        data-scramble-variant="primary"
                        class="group relative flex h-min w-min cursor-pointer flex-row flex-nowrap items-center justify-start gap-[7px] overflow-visible no-underline"
                        href={`/projects/${project.slug}/privacy-policy`}
                    >
                        <div class="relative h-auto w-auto flex-none whitespace-pre">
                            <p class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-text no-underline max-narrow:text-[13px]">Privacy Policy</p>
                        </div>
                        <div class="relative h-2.5 w-2.5 flex-none transition-transform duration-200 ease-out group-hover:rotate-45">
                            <svg class="h-full w-full"><use href="#link-arrow"></use></svg>
                        </div>
                    </a>
                )}
            </div>
        </div>
    )}

</article>
