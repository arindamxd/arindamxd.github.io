---
interface Props {
    title: string;
    description?: string;
    class?: string;
    level?: 2 | 3;
}

const { title, description, class: className = "", level = 2 } = Astro.props;
const HeadingTag = level === 3 ? "h3" : "h2";
---

<div
    data-reveal
    class:list={[
        "relative mb-[30px] flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-start gap-3 overflow-visible p-0 max-narrow:mb-5 max-narrow:gap-2.5",
        className,
    ]}
>
    <div class="relative h-auto w-full flex-none text-balance">
        <HeadingTag
            class="m-0 p-0 text-center font-manrope text-[50px] font-semibold leading-[110%] tracking-[-0.05em] text-text no-underline max-narrow:text-[34px]"
        >
            {title}
        </HeadingTag>
    </div>
    {
        description && (
            <div class="relative h-auto w-full max-w-[350px] flex-none whitespace-pre-wrap break-words text-balance opacity-60">
                <p class="m-0 p-0 text-center font-manrope text-[17px] font-semibold leading-[140%] tracking-[-0.04em] text-text no-underline max-narrow:text-[15px]">
                    {description}
                </p>
            </div>
        )
    }
</div>
