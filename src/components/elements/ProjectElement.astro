---
// props
const { project, index = 0 } = Astro.props;
const delayMs = Math.min(Number(index) * 70, 420);
---

<a
    class="cms-item sticky top-[110px] z-[1] flex h-min w-full flex-none flex-row flex-nowrap content-center items-center justify-start gap-2.5 overflow-visible p-0 no-underline"
    style={`--stagger-delay: ${delayMs}ms`}
    href={`/projects/${project.slug}`}
>
    <div class="relative h-[400px] w-px flex-1 max-framer:h-[280px]">
        <div class="projects-card group relative flex h-full w-full cursor-pointer flex-col flex-nowrap content-center items-center justify-end gap-2.5 overflow-hidden rounded-[45px] p-2.5">
            <div class="caption-info rounded-[50px] bg-bg">
                <div class="caption-info-content">
                    <div class="caption-info-logo rounded-[50px]" style={`background-color: ${project.images.thumb_bg_color}`}>
                        <div class="project-logo">
                            <img decoding="async" loading="lazy" src={project.images.thumb} alt="" />
                        </div>
                    </div>
                    <div class="caption-info-text">
                        <div class="caption-info-text-title" style="outline: none; display: flex; flex-direction: column; justify-content: flex-start; flex-shrink: 0; transform: none;">
                            <p class="m-0 p-0 font-manrope text-[16px] font-semibold leading-[130%] tracking-[-0.04em] text-left text-text whitespace-pre max-framer:text-[14px]">{project.title}</p>
                        </div>
                        <div class="caption-info-text-description" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;opacity:0.6;transform:none">
                            <p class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-text no-underline max-framer:text-[13px]">{project.desc.short}</p>
                        </div>
                    </div>
                </div>
                <div class="caption-info-arrow rounded-full bg-surface">
                    <div class="link-icon-circle-bg" style="image-rendering: pixelated; flex-shrink: 0;" aria-hidden="true">
                        <div class="svg-container" style="width:100%;height:100%;aspect-ratio:inherit">
                            <svg style="width:100%;height:100%;"><use href="#svg12157825541"></use></svg>
                        </div>
                    </div>
                </div>
            </div>
            <div class="project-background-image">
                <div style="position:absolute;border-radius:inherit;top:0;right:0;bottom:0;left:0;">
                    <img decoding="auto" loading="lazy" src={project.images.banner} alt="" style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:cover">
                </div>
            </div>
        </div>
    </div>
</a>
