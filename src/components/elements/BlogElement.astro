---
import { formatDate } from "../../utils/date";

// props
const { blog } = Astro.props;
---

<div class="journal-item">
    <a class="journal-row typography-card-title row-align display-block" style="background-color: var(--color-bg); border-radius: 41px; width: 100%; opacity: 1;" href={`/blogs/${blog.slug}/`}>
        <div class="journal-row-image" style="border-radius: 50px; opacity: 1;">
            <div class="journal-image" style="border-radius: 50px; will-change: transform; opacity: 1; transform: none;">
                <div style="position:absolute;border-radius:inherit;top:0;right:0;bottom:0;left:0;">
                    <img decoding="auto" loading="lazy" src={blog.thumb} alt="" style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:cover">
                </div>
            </div>
        </div>
        <div class="journal-row-title" style="outline: none; display: flex; flex-direction: column; justify-content: flex-start; flex-shrink: 0; transform: none; opacity: 1;">
            <p class="proton-text proton-styles-preset-default">{blog.title}</p>
        </div>
        <div class="journal-row-date" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;opacity:0.5;transform:none">
            <p class="proton-text proton-styles-preset-role" style="--proton-text-alignment:right">{formatDate(blog.date, "short")}</p>
        </div>
    </a>
</div>