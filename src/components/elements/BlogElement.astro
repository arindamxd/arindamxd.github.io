---
import { formatDate } from "../../utils/date";

// props
const { blog, index = 0 } = Astro.props;
const delayMs = Math.min(Number(index) * 55, 360);
---

<div class="cms-item relative h-auto w-full flex-none" style={`--stagger-delay: ${delayMs}ms`}>
    <a
        class="group relative flex h-min w-full cursor-pointer flex-row flex-nowrap items-center justify-start gap-[15px] rounded-[41px] bg-bg py-2.5 pr-5 pl-2.5 no-underline"
        href={`/blogs/${blog.slug}/`}
    >
        <div class="relative aspect-square h-[54px] w-[54px] flex-none overflow-hidden rounded-[50px] transition-transform duration-300 ease-out will-change-transform group-hover:scale-110">
            <div class="absolute inset-0 z-[1] aspect-square h-[54px] rounded-[50px]">
                <div class="absolute inset-0" style="border-radius:inherit;">
                    <img decoding="auto" loading="lazy" src={blog.thumb} alt="" style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:cover">
                </div>
            </div>
        </div>
        <div class="relative h-auto w-px min-w-0 flex-1 text-balance">
            <p class="m-0 p-0 font-manrope text-[16px] font-semibold leading-[130%] tracking-[-0.04em] text-left text-text whitespace-normal max-framer:text-[14px]">{blog.title}</p>
        </div>
        <div class="relative h-auto w-auto flex-none shrink-0 whitespace-pre opacity-50">
            <p class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-text no-underline max-framer:text-[13px] text-right">{formatDate(blog.date, "short")}</p>
        </div>
    </a>
</div>
