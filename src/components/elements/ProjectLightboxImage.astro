---
interface Props {
    src: string;
    alt: string;
}

const { src, alt } = Astro.props;
const label = alt.trim() ? `View ${alt}` : "View image";
---

<button
    type="button"
    class="project-lightbox-trigger"
    data-media-viewer
    data-src={src}
    data-title={alt}
    data-kind="image"
    aria-haspopup="dialog"
    aria-controls="media-viewer-root"
    aria-label={label}
>
    <img decoding="async" loading="lazy" src={src} alt={alt} />
</button>
