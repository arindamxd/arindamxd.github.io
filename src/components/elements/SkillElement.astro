---
// props
const { icon, label } = Astro.props;
---

<div class="skills-icon-wrapper" data-border="true" style="--border-color: #e8e8e8; --border-style: solid; --border-bottom-width: 1px; --border-left-width: 1px; --border-right-width: 1px; --border-top-width: 1px;" title={label} aria-label={label}>
    <div class="skills-icon">
        <div style="position:absolute;border-radius:inherit;top:0;right:0;bottom:0;left:0;">
            <img decoding="auto" loading="lazy" src={icon} alt={label} style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:cover">
        </div>
    </div>
</div>