---
// props
const { icon, label, index = 0 } = Astro.props;
const delayMs = Math.min(Number(index) * 45, 360);
---

<div
    class="skill-chip relative flex-none"
    style={`--skill-delay: ${delayMs}ms`}
    title={label}
    aria-label={label}
>
    <div
        class="group relative flex size-[54px] flex-row flex-nowrap content-center items-center justify-center overflow-hidden rounded-[9px] border border-border bg-surface transition-[transform,border-color,box-shadow,background-color] duration-300 ease-[cubic-bezier(0.68,0,0.31,0.91)] will-change-transform hover:-translate-y-0.5 hover:border-border hover:bg-bg hover:shadow-[0_8px_18px_rgba(0,0,0,0.06)] dark:hover:shadow-[0_8px_18px_rgba(0,0,0,0.35)]"
    >
        <div class="relative aspect-square size-[30px] flex-none overflow-visible transition-transform duration-300 ease-out group-hover:scale-110">
            <div class="absolute inset-0 rounded-[inherit]">
                <img
                    decoding="async"
                    loading="lazy"
                    src={icon}
                    alt={label}
                    class="block size-full rounded-[inherit] object-cover object-center"
                />
            </div>
        </div>
    </div>
</div>
