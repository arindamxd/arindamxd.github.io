---
// props
const { icon, label } = Astro.props;
---

<div
    class="relative flex size-[54px] flex-none flex-row flex-nowrap content-center items-center justify-center overflow-hidden rounded-[9px] border border-[#e8e8e8] bg-surface"
    title={label}
    aria-label={label}
>
    <div class="relative aspect-square size-[30px] flex-none overflow-visible">
        <div class="absolute inset-0 rounded-[inherit]">
            <img
                decoding="async"
                loading="lazy"
                src={icon}
                alt={label}
                class="block size-full rounded-[inherit] object-cover object-center"
            />
        </div>
    </div>
</div>
