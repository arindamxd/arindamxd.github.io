---
import { Image } from 'astro:assets';
import {
    previewAuthor,
    previewExperiences,
    previewYearsOfExperience,
} from "../../utils/design-preview-data";

interface Props {
    /** `/design` gallery — live chrome, dummy copy */
    preview?: boolean;
}

const { preview = false } = Astro.props;

const author = preview
    ? previewAuthor
    : (await import("../../content/author-metadata.json")).default;
const experiences = preview
    ? previewExperiences
    : (await import("../../content/experiences-metadata.json")).default;

let years: number;
if (preview) {
    years = previewYearsOfExperience;
} else {
    const today = new Date();
    const start =
        experiences.data.length > 0
            ? new Date(
                  experiences.data.reduce((earliest, exp) =>
                      new Date(exp.start) < new Date(earliest.start) ? exp : earliest,
                  ).start,
              )
            : new Date();

    years = today.getFullYear() - start.getFullYear();

    if (
        today.getMonth() < start.getMonth() ||
        (today.getMonth() === start.getMonth() && today.getDate() < start.getDate())
    ) {
        years--;
    }
}
---

<section class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-20 overflow-hidden p-0 max-narrow:gap-[50px] max-narrow:px-2.5">

    <div class="hero-tie-container appear-hero-tie" style="transform: translateX(-50%);">
        <div class="hero-tie hero-tie-centered">
            <div class="hero-tie-stripe"></div>
            <div class="hero-tie-holder" style="background-color: rgb(23, 23, 23); border-radius: 6px; opacity: 1;"></div>
            <div class="hero-tie-box" style="background: linear-gradient(rgb(7, 7, 7) 0%, rgb(45, 45, 45) 100%); border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; opacity: 1;"></div>
        </div>
    </div>

    <div class="hero-badge">
        <div id="hero" class="hero-card appear-hero-card shadow-[inset_0_0_0_1px_var(--color-border)]">
            <div class="hero-card-hole shadow-[inset_0_0_0_1px_var(--color-border)]"></div>

            <div class="hero-card-content">
                <div class="hero-card-slot-container">
                    <div class="hero-card-slot-div hero-card-slot-centered" style="width: 100%; opacity: 1;">
                        <div class="hero-card-slot-bar-active"></div>
                        <div class="hero-card-slot-bar-active"></div>
                        <div class="hero-card-slot-bar-inactive"></div>
                    </div>
                </div>

                <!-- Groups identity + slogan with 36px gap (not the White 40px rhythm) -->
                <div class="hero-card-content-identity">
                    <div class="hero-card-content-top">
                        <div class="hero-card-content-top-left">
                            <div class="hero-card-content-avatar">
                                <div style="position:absolute;border-radius:inherit;top:0;right:0;bottom:0;left:0">
                                    <Image decoding="async" loading="eager" src={author.intro.avatar} alt="" width={70} height={70} style="border-radius:inherit; object-fit:fill;" />
                                </div>
                            </div>
                            <div class="hero-card-content-main">
                                <div class="hero-card-content-main-text">
                                    <div class="hero-card-content-main-text-name" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none">
                                        <p class="m-0 p-0 font-manrope text-[22px] font-semibold leading-[120%] tracking-[-0.04em] text-text no-underline max-narrow:text-[19px]">{author.name}</p>
                                    </div>
                                    <div class="hero-card-content-main-text-role" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none">
                                        <p class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-text no-underline max-narrow:text-[13px]">{author.role}<br>{author.subRole}</p>
                                    </div>
                                </div>
                                <div class="relative flex h-min w-min flex-none flex-row flex-nowrap items-center justify-center gap-2.5 overflow-visible p-0">
                                    {author.intro.social.map((link) => (
                                        <div class="relative aspect-square size-[22px] flex-none">
                                            <a aria-label={`Link to ${link.name}`} class="group relative flex size-full cursor-pointer flex-col items-center justify-center overflow-visible rounded-full bg-bg no-underline" href={link.url} target="_blank" rel="noopener">
                                                <div class="relative size-full flex-1 opacity-40 transition-opacity duration-500 ease-in-out group-hover:opacity-100">
                                                    <div class="absolute inset-0" style="border-radius:inherit">
                                                        <img decoding="auto" src={link.icon} alt="" class="block size-full rounded-[inherit] object-cover object-center brightness-0 dark:invert" />
                                                    </div>
                                                </div>
                                            </a>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                        <div class="hero-card-content-top-available">
                            <div class="available-dot-container">
                                <div class="available-pulse"></div>
                            </div>
                            <div class="available-text-container" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none">
                                <!-- Content will be populated by available-text.ts -->
                            </div>
                        </div>
                    </div>
                    <div class="hero-card-content-slogan" style="outline: none; display: flex; flex-direction: column; justify-content: flex-start; flex-shrink: 0;">
                        <h1 class="m-0 p-0 font-manrope text-[70px] font-semibold leading-[90%] tracking-[-0.04em] text-text no-underline max-narrow:text-[48px]">{author.intro.title}</h1>
                    </div>
                </div>
                <div class="hero-card-content-others">
                    <div class="hero-card-content-badge">
                        <div class="hero-card-content-badge-text-container" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none">
                            <p class="m-0 p-0 font-manrope text-[11px] font-semibold leading-none tracking-[-0.05em] text-left text-text whitespace-pre">{years}+ Years of Experience</p>
                        </div>
                    </div>
                    <div class="hero-card-content-description" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none">
                        <p class="m-0 p-0 font-manrope text-[17px] font-semibold leading-[140%] tracking-[-0.04em] text-text no-underline max-narrow:text-[15px]">{author.intro.subTitle}</p>
                    </div>
                </div>
                <div class="hero-card-content-buttons appear-fade-up-sm appear-delay-1">
                    <div class="relative h-auto w-auto flex-none">
                        <a data-scramble data-scramble-variant="primary" class="group relative flex h-[58px] w-min cursor-pointer flex-row flex-nowrap content-center items-center justify-start gap-4 overflow-hidden rounded-full py-[3px] pr-[74px] pl-7 no-underline" href={author.intro.resumeURL} target="_blank" rel="noopener">
                            <div class="relative z-[2] h-auto w-auto flex-none whitespace-pre">
                                <p class="m-0 p-0 font-manrope text-[17px] font-semibold leading-[140%] tracking-[-0.04em] text-white no-underline max-narrow:text-[15px]">Resume</p>
                            </div>
                            <div class="absolute top-[3px] right-[3px] z-[2] flex h-[52px] w-[52px] flex-col flex-nowrap content-center items-center justify-center rounded-full bg-white p-0">
                                <div class="relative h-2.5 w-2.5 flex-none transition-transform duration-200 ease-out group-hover:rotate-45" style="image-rendering: pixelated;">
                                    <div class="h-full w-full" style="aspect-ratio:inherit">
                                        <svg class="h-full w-full"><use href="#link-arrow"></use></svg>
                                    </div>
                                </div>
                            </div>
                            <div class="absolute inset-0 z-0 overflow-hidden rounded-full bg-primary transition-[filter] duration-200 ease-in-out group-hover:brightness-95"></div>
                        </a>
                    </div>
                    <div class="relative h-[58px] w-auto flex-none">
                        <a data-scramble class="group relative flex h-[58px] w-min cursor-pointer flex-row flex-nowrap content-center items-center justify-center gap-4 overflow-visible rounded-full bg-surface px-7 py-5 no-underline transition-colors duration-200 ease-in-out hover:bg-inactive" href={preview ? "#project" : "#projects"}>
                            <div class="relative z-[1] h-auto w-auto flex-none whitespace-pre">
                                <p class="m-0 p-0 font-manrope text-[17px] font-semibold leading-[140%] tracking-[-0.04em] text-text no-underline max-narrow:text-[15px]">My work</p>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

            <div class="hero-card-bottom">
                <div class="hero-card-bottom-location">
                    <div class="location-icon text-text" style="image-rendering:pixelated;flex-shrink:0;fill:currentColor;color:currentColor">
                        <div class="svg-container" style="width:100%;height:100%;aspect-ratio:inherit">
                            <svg style="width:100%;height:100%;" viewBox="0 0 13 14" preserveAspectRatio="none" width="100%" height="100%"><use href="#svg-1885035283_1212"></use></svg>
                        </div>
                    </div>
                    <div class="location-text-container" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none">
                        <p class="m-0 p-0 font-manrope text-[13px] font-semibold leading-[120%] tracking-[-0.04em] text-left text-text max-narrow:text-[12px] max-narrow:tracking-[-0.02em]"><span class="text-text/60">Located in&nbsp;</span>{author.location}<span class="text-text/60">,&nbsp;available worldwide.</span></p>
                    </div>
                </div>
                <div class="relative flex h-auto w-auto flex-none items-center">
                    <a data-scramble class="group relative flex h-min w-min cursor-pointer flex-row flex-nowrap items-center justify-start gap-[7px] overflow-visible py-0 no-underline" href={author.intro.cardLinkURL} target="_blank" rel="noopener">
                        <p class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-text no-underline max-narrow:text-[13px]">{author.intro.cardLinkText}</p>
                        <div class="relative h-2.5 w-2.5 flex-none transition-transform duration-200 ease-out group-hover:rotate-45">
                            <svg class="h-full w-full"><use href="#link-arrow"></use></svg>
                        </div>
                    </a>
                </div>
            </div>

        </div>
    </div>

</section>
