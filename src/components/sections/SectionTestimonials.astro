---
// data
const author = (await import("../../content/author-metadata.json")).default;
const metadata = (await import("../../content/testimonials-metadata.json")).default;
---

<section id="testimonials" class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-[50px] overflow-visible p-0 max-framer:gap-[30px] max-framer:px-2.5">

    <!-- Heading -->
    <div class="relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-start gap-6 overflow-visible p-0 max-framer:gap-4">
        <div class="relative h-auto w-full flex-none text-balance">
            <h2 class="m-0 p-0 font-manrope text-[50px] font-semibold leading-[110%] tracking-[-0.05em] text-center text-text no-underline max-framer:text-[34px]">{metadata.title}</h2>
        </div>
        <div class="relative h-auto w-full max-w-[350px] flex-none whitespace-pre-wrap break-words text-balance opacity-60">
            <p class="m-0 p-0 font-manrope text-[17px] font-semibold leading-[140%] tracking-[-0.04em] text-text no-underline max-framer:text-[15px] text-center">{metadata.description}</p>
        </div>
    </div>

    <!-- Phone stage: hand/side-art + slider CSS kept in sections.css -->
    <div class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-[60px] overflow-visible px-0 pt-0 pb-[210px] max-framer:gap-10 max-framer:px-2.5 max-framer:pb-0">
        <div class="relative flex h-min w-full flex-none flex-row flex-nowrap content-center items-center justify-center gap-8 overflow-visible p-0">

            <!-- Left Screen Art -->
            <div class="screen-left-art"></div>

            <!-- Mobile Phone with Testimonial -->
            <div class="relative z-[1] h-auto w-auto flex-none">
                <div class="testimonials main-wrapper" style="background-color: var(--color-primary); opacity: 1; border-radius: 60px;">

                    <!-- Mobile Border -->
                    <div class="mobile-border">
                        <div style="position:absolute;border-radius:inherit;top:0;right:0;bottom:0;left:0" data-proton-background-image-wrapper="true">
                            <img decoding="auto" loading="lazy" src="/assets/resources/phone-border.png" alt="" style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:cover">
                        </div>
                    </div>

                    <!-- Testimonial Gestures -->
                    <div class="gestures" style="border-radius: 60px; opacity: 1;">
                        <div class="gesture-left-container">
                            <div id="prevButton" class="gesture-item gesture-wrapper" style="height: 100%; width: 100%; opacity: 1;">
                                <div class="gesture-item-full" style="background:linear-gradient(270deg, rgba(0, 0, 0, 0) -4%, rgba(0, 0, 0, 0.16) 100%);"></div>
                            </div>
                        </div>
                        <div class="gesture-right-container">
                            <div id="nextButton" class="gesture-item gesture-wrapper" style="height: 100%; width: 100%; opacity: 1;">
                                <div class="gesture-item-full" style="background:linear-gradient(270deg, rgba(0, 0, 0, 0.16) 0%, rgba(0, 0, 0, 0) 100%);"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Testimonial Content -->
                    <div class="vertical-stack">
                        <div class="vertical-stack-top">

                            <!-- Testimonial Progress Bar -->
                            <div id="progressBarsContainer" class="progress-bar"></div>

                            <!-- Personal Details -->
                            <div id="testimonialPerson" class="vertical-stack-top-person" style="display: none;">
                                <div class="vertical-stack-top-person-avatar" style="opacity: 1; border-radius: 100%;">
                                    <div style="position:absolute;border-radius:inherit;top:0;right:0;bottom:0;left:0" data-proton-background-image-wrapper="true">
                                        <img decoding="auto" loading="lazy" sizes="33px" src={author.intro.avatar} alt="" style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:fill">
                                    </div>
                                </div>
                                <div class="vertical-stack-top-person-info">
                                    <div class="vertical-stack-top-person-info-name" style="outline: none; display: flex; flex-direction: column; justify-content: center; flex-shrink: 0; transform: none; opacity: 1;">
                                        <p class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-left text-bg">{author.name}</p>
                                    </div>
                                    <div class="vertical-stack-top-person-info-role" style="outline:none;display:flex;flex-direction:column;justify-content:center;flex-shrink:0;opacity:0.6;transform:none;padding-bottom:2px;">
                                        <p class="m-0 p-0 font-manrope text-[12px] font-semibold leading-none tracking-[-0.04em] text-left text-bg">{author.role}</p>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <!-- Testimonial Info -->
                        <div class="vertical-stack-info" style="will-change: transform; opacity: 1; transform: none; transform-origin: 50% 50% 0px;">
                            <div class="vertical-stack-info-data" style="transform: none; transform-origin: 50% 50% 0px;">
                                <div id="starsIcon" class="stars-icon" style="image-rendering: pixelated; flex-shrink: 0; transform: none; transform-origin: 50% 50% 0px; display: none;" aria-hidden="true">
                                    <div class="svg-container" style="width:100%;height:100%;aspect-ratio:inherit">
                                        <svg style="width:100%;height:100%;"><use href="#svg8935606026"></use></svg>
                                    </div>
                                </div>
                                <div class="vertical-stack-info-recommendation-text" style="outline: none; display: flex; flex-direction: column; justify-content: center; flex-shrink: 0; transform: none; transform-origin: 50% 50% 0px;">
                                    <p id="testimonialText" class="m-0 p-0 font-manrope text-[22px] font-semibold leading-[120%] tracking-[-0.04em] text-bg"></p>
                                </div>
                            </div>
                            <div class="vertical-stack-info-recommendation-author" style="transform: none; transform-origin: 50% 50% 0px;">
                                <div class="vertical-stack-info-recommendation-author-name" style="outline: none; display: flex; flex-direction: column; justify-content: center; flex-shrink: 0; transform: none; transform-origin: 50% 50% 0px;">
                                    <p id="testimonialAuthor" class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-left text-bg"></p>
                                </div>
                                <div class="vertical-stack-info-recommendation-author-role" style="outline: none; display: flex; flex-direction: column; justify-content: center; flex-shrink: 0; opacity: 0.6; transform: none; transform-origin: 50% 50% 0px;">
                                    <p id="testimonialPosition" class="m-0 p-0 font-manrope text-[12px] font-semibold leading-none tracking-[-0.04em] text-left text-bg"></p>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Testimonial Image -->
                    <div class="vertical-stack-image" style="opacity:0.07">
                        <div class="vertical-stack-image-background" style="will-change: transform; opacity: 1; transform: none; border-radius: 60px;">
                            <div style="position:absolute;border-radius:inherit;top:0;right:0;bottom:0;left:0" data-proton-background-image-wrapper="true">
                                <img id="screenBg" decoding="auto" loading="lazy" alt="" style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:cover;">
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Right Screen Art -->
            <div class="screen-right-art" style="will-change: transform; opacity: 1; transform: none;"></div>

            <!-- Hand Art -->
            <div class="hand-art" style="will-change: transform; opacity: 1; transform: none;">
                <div style="position:absolute;border-radius:inherit;top:0;right:0;bottom:0;left:0">
                    <img decoding="auto" loading="lazy" src="/assets/resources/holding-phone.png" alt="Close-up of the hand holding the mobile phone" style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:cover">
                </div>
            </div>

        </div>
    </div>

</section>
