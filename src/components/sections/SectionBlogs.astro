---
import type { Blog } from "../../types/blog";
import BlogElement from "../elements/BlogElement.astro";
import BlogViewAll from "../elements/BlogViewAll.astro";

// data
const metadata = (await import("../../content/blogs-metadata.json")).default;

// return early if no blogs
if (metadata.data.length === 0) {
    return;
}

// props
const { home = false, slug = false, limit = false, current = null } = Astro.props;

// parse dates
const blogs: Blog[] = metadata.data.map(blog => ({
    ...blog,
    date: new Date(blog.date),
}));

// select all random except current if provided
const filtered = current ? (
    blogs
        .filter((item) => item.slug !== current.slug)
        .sort(() => Math.random() - 0.5)
) : blogs;

// sort by date descending
const sorted = current ? filtered : [...blogs].sort((a, b) =>
    new Date(b.date).getTime() - new Date(a.date).getTime()
);

// show only 3 on home, else all
const items = limit ? sorted.slice(0, 3) : sorted;

// section styles and text
const headerPad = slug || home ? "p-0" : "pt-[110px] p-0";
const title = slug ? "More articles" : metadata.title;
const description = slug ? (items.length < 1 ? "Coming soon ..." : "Check out some of my favorite & most recent articles.") : metadata.description;
---

<section id="blogs" class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-[50px] overflow-visible p-0 max-framer:gap-[30px] max-framer:px-2.5">

    <!-- Heading -->
    <div class={`relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-start gap-6 overflow-visible max-framer:gap-4 ${headerPad}`}>
        <div class="relative h-auto w-full flex-none text-balance">
            <h2 class="m-0 p-0 font-manrope text-[50px] font-semibold leading-[110%] tracking-[-0.05em] text-center text-text no-underline max-framer:text-[34px]">{title}</h2>
        </div>
        <div class="relative h-auto w-full max-w-[350px] flex-none whitespace-pre-wrap break-words text-balance opacity-60">
            <p class="m-0 p-0 font-manrope text-[17px] font-semibold leading-[140%] tracking-[-0.04em] text-text no-underline max-framer:text-[15px] text-center">{description}</p>
        </div>
    </div>

    <!-- Articles Container -->
    {items.length > 0 && (
        <div
            class="relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-center gap-2.5 rounded-[45px] bg-surface p-2.5"
            data-border="true"
            style="--border-bottom-width: 1px; --border-color: #e9e9e9; --border-left-width: 1px; --border-right-width: 1px; --border-style: solid; --border-top-width: 1px;"
        >

            <!-- Articles -->
            {items.map((blog) => (
                <BlogElement blog={blog} />
            ))}

            <!-- View All -->
            {home && metadata.data.length > 3 && (
                <BlogViewAll />
            )}

        </div>
    )}

</section>
