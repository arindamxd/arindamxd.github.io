---
import BlogElement from "../elements/BlogElement.astro";
import BlogViewAll from "../elements/BlogViewAll.astro";
import { getBlogCatalogMeta, getBlogs } from "../../utils/blogs";
import {
    previewBlogCatalogMeta,
    previewBlogs,
} from "../../utils/design-preview-data";

interface Props {
    home?: boolean;
    slug?: boolean;
    limit?: boolean;
    current?: { slug: string } | null;
    preview?: boolean;
}

const {
    home = false,
    slug = false,
    limit = false,
    current = null,
    preview = false,
} = Astro.props;

const blogs = preview ? previewBlogs : getBlogs();
const metadata = preview ? previewBlogCatalogMeta : getBlogCatalogMeta();

if (blogs.length === 0) {
    return;
}

const filtered = current
    ? blogs.filter((item) => item.slug !== current.slug).sort(() => Math.random() - 0.5)
    : blogs;

const sorted = current
    ? filtered
    : [...blogs].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const items = limit ? sorted.slice(0, 3) : sorted;

const headerPad = slug || home ? "p-0" : "pt-[110px] p-0";
const title = slug ? "More articles" : metadata.title;
const description = slug
    ? items.length < 1
        ? "Coming soon ..."
        : "Check out some of my favorite & most recent articles."
    : metadata.description;
---

<section
    id={preview ? "blogs-preview" : "blogs"}
    class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-[50px] overflow-visible p-0 max-narrow:gap-[30px] max-narrow:px-2.5"
>
    <div
        data-reveal
        class={`relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-start gap-3 overflow-visible max-narrow:gap-2.5 ${headerPad}`}
    >
        <div class="relative h-auto w-full flex-none text-balance">
            <h2
                class="m-0 p-0 font-manrope text-[50px] font-semibold leading-[110%] tracking-[-0.05em] text-center text-text no-underline max-narrow:text-[34px]"
            >
                {title}
            </h2>
        </div>
        <div
            class="relative h-auto w-full max-w-[350px] flex-none whitespace-pre-wrap break-words text-balance opacity-60"
        >
            <p
                class="m-0 p-0 font-manrope text-[17px] font-semibold leading-[140%] tracking-[-0.04em] text-text no-underline max-narrow:text-[15px] text-center"
            >
                {description}
            </p>
        </div>
    </div>

    {
        items.length > 0 && (
            <div
                data-reveal
                data-reveal-stagger
                class="relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-center gap-[9px] rounded-[45px] bg-surface p-[9px] shadow-[inset_0_0_0_1px_var(--color-border)] max-narrow:gap-1.5 max-narrow:p-1.5"
            >
                {items.map((blog, i) => (
                    <BlogElement blog={blog} index={i} />
                ))}

                {home && blogs.length > 3 && (
                    <div
                        class="cms-item relative h-auto w-full flex-none"
                        style={`--stagger-delay: ${Math.min(items.length * 55, 360)}ms`}
                    >
                        <BlogViewAll />
                    </div>
                )}
            </div>
        )
    }
</section>
