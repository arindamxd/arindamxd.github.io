---
import ProjectElement from "./../elements/ProjectElement.astro";
import ProjectViewAll from "./../elements/ProjectViewAll.astro";
import { getProjectCatalogMeta, getProjects } from "../../utils/projects";

const projects = getProjects();
const metadata = getProjectCatalogMeta();

// return early if no projects
if (projects.length === 0) {
    return;
}

// props
const { home = false, slug = false, limit = false, current = null } = Astro.props;

// select all random except current if provided
const filtered = current ? (
    projects
        .filter((item) => item.slug !== current.slug)
        .sort(() => Math.random() - 0.5)
) : projects;

// sort by date descending
const sorted = current ? filtered : [...filtered].sort((a, b) =>
    b.header.updated_date.getTime() - a.header.updated_date.getTime()
);

// show only 2 on home, else all
const items = limit ? sorted.slice(0, 2) : sorted;

// section styles and text
const headerPad = slug || home ? "p-0" : "pt-[110px] p-0";
const title = slug ? "More projects" : metadata.title;
const description = slug ? (items.length < 1 ? "Coming soon ..." : "Check out some of my favorite & most recent projects.") : metadata.description;
---

<section id="projects" class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-[50px] overflow-visible p-0 max-narrow:gap-[30px] max-narrow:px-2.5">

    <!-- Heading -->
    <div data-reveal class={`relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-start gap-3 overflow-visible max-narrow:gap-2.5 ${headerPad}`}>
        <div class="relative h-auto w-full flex-none text-balance">
            <h2 class="m-0 p-0 font-manrope text-[50px] font-semibold leading-[110%] tracking-[-0.05em] text-center text-text no-underline max-narrow:text-[34px]">{title}</h2>
        </div>
        <div class="relative h-auto w-full max-w-[350px] flex-none whitespace-pre-wrap break-words text-balance opacity-60">
            <p class="m-0 p-0 font-manrope text-[17px] font-semibold leading-[140%] tracking-[-0.04em] text-text no-underline max-narrow:text-[15px] text-center">{description}</p>
        </div>
    </div>

    <!-- Projects List -->
    {items.length > 0 && (
        <div
            data-reveal
            data-reveal-stagger
            class="relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-center gap-2.5 overflow-visible p-0"
        >
            {items.map((project, i) => (
                <ProjectElement project={project} index={i} />
            ))}

            <!-- View All -->
            {home && projects.length > 2 && (
                <div class="cms-item relative h-auto w-full flex-none" style={`--stagger-delay: ${Math.min(items.length * 70, 420)}ms`}>
                    <ProjectViewAll />
                </div>
            )}
        </div>
    )}

</section>
