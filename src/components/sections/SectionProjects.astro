---
import ProjectElement from "./../elements/ProjectElement.astro";
import ProjectViewAll from "./../elements/ProjectViewAll.astro";

// data
const metadata = (await import("../../content/projects-metadata.json")).default;

// return early if no projects
if (metadata.data.length === 0) {
    return;
}

// props
const { home = false, slug = false, limit = false, current = null } = Astro.props;

// select all random except current if provided
const filtered = current ? (
    metadata.data
        .filter((item) => item.slug !== current.slug)
        .sort(() => Math.random() - 0.5)
) : metadata.data;

// sort by date descending
const sorted = current ? filtered : [...filtered].sort((a, b) =>
    new Date(b.page.header.updated_date).getTime() - new Date(a.page.header.updated_date).getTime()
);

// show only 2 on home, else all
const items = limit ? sorted.slice(0, 2) : sorted;

// section styles and text
const headerPad = slug || home ? "p-0" : "pt-[110px] p-0";
const title = slug ? "More projects" : metadata.title;
const description = slug ? (items.length < 1 ? "Coming soon ..." : "Check out some of my favorite & most recent projects.") : metadata.description;
---

<section id="projects" class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-[50px] overflow-visible p-0 max-framer:gap-[30px] max-framer:px-2.5">

    <!-- Heading -->
    <div data-reveal class={`relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-start gap-3 overflow-visible max-framer:gap-2.5 ${headerPad}`}>
        <div class="relative h-auto w-full flex-none text-balance">
            <h2 class="m-0 p-0 font-manrope text-[50px] font-semibold leading-[110%] tracking-[-0.05em] text-center text-text no-underline max-framer:text-[34px]">{title}</h2>
        </div>
        <div class="relative h-auto w-full max-w-[350px] flex-none whitespace-pre-wrap break-words text-balance opacity-60">
            <p class="m-0 p-0 font-manrope text-[17px] font-semibold leading-[140%] tracking-[-0.04em] text-text no-underline max-framer:text-[15px] text-center">{description}</p>
        </div>
    </div>

    <!-- Projects List -->
    <div class="relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-center gap-2.5 overflow-visible p-0">
        {items.map((project) => (
            <ProjectElement project={project} />
        ))}

        <!-- View All -->
        {home && metadata.data.length > 2 && (
            <ProjectViewAll />
        )}
    </div>

</section>
