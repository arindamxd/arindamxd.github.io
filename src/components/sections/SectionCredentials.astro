---
import SectionHeading from "../elements/SectionHeading.astro";
import { previewCredentials } from "../../utils/design-preview-data";

interface Props {
    preview?: boolean;
}

type CredentialItem = {
    title: string;
    org?: string;
    url?: string;
};

const { preview = false } = Astro.props;

const metadata = preview
    ? previewCredentials
    : (await import("../../content/credentials-metadata.json")).default;

const sectionId = preview ? "credentials-preview" : "credentials";
const idPrefix = sectionId;
---

<section
    id={sectionId}
    class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-0 overflow-visible p-0 max-narrow:px-2.5"
>
    <SectionHeading title={metadata.title} description={metadata.description} />

    <div
        data-reveal
        data-credentials-accordion
        class="relative flex h-min w-full flex-none flex-col flex-nowrap content-start items-start justify-start gap-0 overflow-visible px-8 max-narrow:px-[15px]"
    >
        {metadata.groups.map((group, index) => (
                <div
                    class="credentials-item relative flex h-min w-full flex-none flex-col flex-nowrap content-start items-start justify-start gap-0 overflow-hidden border-t border-[color:var(--color-border)] p-0"
                    data-open="false"
                >
                    <button
                        type="button"
                        data-scramble
                        data-scramble-variant="auto"
                        class="credentials-trigger relative flex h-min w-full cursor-pointer flex-row flex-nowrap content-center items-center justify-between gap-4 overflow-visible border-0 bg-transparent py-5 text-left max-narrow:py-4"
                        aria-expanded="false"
                        aria-controls={`${idPrefix}-panel-${index}`}
                        id={`${idPrefix}-trigger-${index}`}
                    >
                        <span data-scramble-text class="m-0 min-w-0 p-0 font-manrope text-[20px] font-semibold leading-[130%] tracking-[-0.04em] text-text max-narrow:text-[17px]">
                            {group.title}
                        </span>
                        <span class="credentials-icon relative h-5 w-5 flex-none text-text" aria-hidden="true">
                            <svg class="h-full w-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                <path class="credentials-icon-h" d="M5 12h14" />
                                <path class="credentials-icon-v" d="M12 5v14" />
                            </svg>
                        </span>
                    </button>

                    <div
                        id={`${idPrefix}-panel-${index}`}
                        class="credentials-panel relative w-full"
                        role="region"
                        aria-labelledby={`${idPrefix}-trigger-${index}`}
                        inert
                    >
                        <div class="credentials-panel-inner relative flex w-full flex-none flex-col flex-nowrap content-start items-start justify-start gap-0 pb-5 pl-5 max-narrow:pb-4 max-narrow:pl-4">
                            {group.items.map((raw) => {
                                const item = raw as CredentialItem;
                                const hasOrg = Boolean(item.org);
                                const href = item.url?.trim() || "";
                                const rowClass = [
                                    "relative grid w-full items-start gap-x-5 overflow-visible border-t border-border/40 py-[14px] max-narrow:gap-x-0 max-narrow:gap-y-1 max-narrow:py-3",
                                    hasOrg
                                        ? "grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] max-narrow:grid-cols-1"
                                        : "grid-cols-1",
                                ];
                                const titleClass = "m-0 min-w-0 p-0 font-manrope text-[16px] font-semibold leading-[135%] tracking-[-0.04em] text-left text-text max-narrow:text-[14px]";
                                const orgClass = "m-0 min-w-0 p-0 font-manrope text-[14px] font-semibold leading-[135%] tracking-[-0.04em] text-right text-text/55 max-narrow:text-left max-narrow:text-[13px]";

                                return href ? (
                                    <a
                                        href={href}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class:list={[...rowClass, "group no-underline transition-opacity hover:opacity-80"]}
                                    >
                                        <p class={titleClass}>
                                            {item.title}
                                            <span class="ml-1.5 inline-block h-[10px] w-[10px] translate-y-[-0.05em] align-baseline opacity-45 transition-opacity group-hover:opacity-100" aria-hidden="true">
                                                <svg class="h-full w-full"><use href="#link-arrow"></use></svg>
                                            </span>
                                        </p>
                                        {hasOrg && <p class={orgClass}>{item.org}</p>}
                                    </a>
                                ) : (
                                    <div class:list={rowClass}>
                                        <p class={titleClass}>{item.title}</p>
                                        {hasOrg && <p class={orgClass}>{item.org}</p>}
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                </div>
        ))}
    </div>
</section>
