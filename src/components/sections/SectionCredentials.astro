---
const metadata = (await import("../../content/credentials-metadata.json")).default;
---

<section id="credentials" class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-[50px] overflow-visible p-0 max-narrow:gap-[30px] max-narrow:px-2.5">

    <!-- Heading -->
    <div data-reveal class="relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-start gap-3 overflow-visible p-0 max-narrow:gap-2.5">
        <div class="relative h-auto w-full flex-none text-balance">
            <h2 class="m-0 p-0 font-manrope text-[50px] font-semibold leading-[110%] tracking-[-0.05em] text-center text-text no-underline max-narrow:text-[34px]">{metadata.title}</h2>
        </div>
        <div class="relative h-auto w-full max-w-[350px] flex-none whitespace-pre-wrap break-words text-balance opacity-60">
            <p class="m-0 p-0 font-manrope text-[17px] font-semibold leading-[140%] tracking-[-0.04em] text-text no-underline max-narrow:text-[15px] text-center">{metadata.description}</p>
        </div>
    </div>

    <div
        data-reveal
        data-credentials-accordion
        class="relative flex h-min w-full flex-none flex-col flex-nowrap content-start items-start justify-start gap-0 overflow-visible px-8 max-narrow:px-[15px]"
    >
        {metadata.groups.map((group, index) => (
                <div
                    class="credentials-item relative flex h-min w-full flex-none flex-col flex-nowrap content-start items-start justify-start gap-0 overflow-hidden border-t border-[color:var(--color-border)] p-0"
                    data-open="false"
                >
                    <button
                        type="button"
                        data-scramble
                        data-scramble-variant="auto"
                        class="credentials-trigger relative flex h-min w-full cursor-pointer flex-row flex-nowrap content-center items-center justify-between gap-4 overflow-visible border-0 bg-transparent py-5 text-left max-narrow:py-4"
                        aria-expanded="false"
                        aria-controls={`credentials-panel-${index}`}
                        id={`credentials-trigger-${index}`}
                    >
                        <span data-scramble-text class="m-0 min-w-0 p-0 font-manrope text-[20px] font-semibold leading-[130%] tracking-[-0.04em] text-text max-narrow:text-[17px]">
                            {group.title}
                        </span>
                        <span class="credentials-icon relative h-5 w-5 flex-none text-text" aria-hidden="true">
                            <svg class="h-full w-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                <path class="credentials-icon-h" d="M5 12h14" />
                                <path class="credentials-icon-v" d="M12 5v14" />
                            </svg>
                        </span>
                    </button>

                    <div
                        id={`credentials-panel-${index}`}
                        class="credentials-panel relative w-full"
                        role="region"
                        aria-labelledby={`credentials-trigger-${index}`}
                        inert
                    >
                        <div class="credentials-panel-inner relative flex w-full flex-none flex-col flex-nowrap content-start items-start justify-start gap-0 pb-5 pl-5 max-narrow:pb-4 max-narrow:pl-4">
                            {group.items.map((item) => {
                                const hasOrg = Boolean(item.org);
                                const rowClass = [
                                    "relative grid w-full items-start gap-x-5 overflow-visible border-t border-border/40 py-[14px] max-narrow:gap-x-0 max-narrow:gap-y-1 max-narrow:py-3",
                                    hasOrg
                                        ? "grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] max-narrow:grid-cols-1"
                                        : "grid-cols-1",
                                ];
                                const titleClass = "m-0 min-w-0 p-0 font-manrope text-[16px] font-semibold leading-[135%] tracking-[-0.04em] text-left text-text max-narrow:text-[14px]";
                                const orgClass = "m-0 min-w-0 p-0 font-manrope text-[14px] font-semibold leading-[135%] tracking-[-0.04em] text-right text-text/55 max-narrow:text-left max-narrow:text-[13px]";

                                return item.url ? (
                                    <a
                                        href={item.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class:list={[...rowClass, "group no-underline transition-opacity hover:opacity-80"]}
                                    >
                                        <p class={titleClass}>
                                            {item.title}
                                            <span class="ml-1.5 inline-block h-[10px] w-[10px] translate-y-[-0.05em] align-baseline opacity-45 transition-opacity group-hover:opacity-100" aria-hidden="true">
                                                <svg class="h-full w-full"><use href="#link-arrow"></use></svg>
                                            </span>
                                        </p>
                                        {hasOrg && <p class={orgClass}>{item.org}</p>}
                                    </a>
                                ) : (
                                    <div class:list={rowClass}>
                                        <p class={titleClass}>{item.title}</p>
                                        {hasOrg && <p class={orgClass}>{item.org}</p>}
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                </div>
        ))}
    </div>

</section>

<style>
    .credentials-panel {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .credentials-item[data-open="true"] .credentials-panel {
        grid-template-rows: 1fr;
    }

    .credentials-panel-inner {
        min-height: 0;
        overflow: hidden;
        opacity: 0;
        transition: opacity 0.28s ease;
    }

    .credentials-item[data-open="true"] .credentials-panel-inner {
        opacity: 1;
    }

    .credentials-icon-v {
        transform-origin: center;
        transition:
            transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
            opacity 0.25s ease;
    }

    .credentials-item[data-open="true"] .credentials-icon-v {
        transform: scaleY(0);
        opacity: 0;
    }

    .credentials-trigger:focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 4px;
        border-radius: 4px;
    }
</style>

<script>
    function setCredentialsOpen(item: Element, open: boolean) {
        item.setAttribute("data-open", open ? "true" : "false");
        const btn = item.querySelector(".credentials-trigger");
        if (btn instanceof HTMLButtonElement) {
            btn.setAttribute("aria-expanded", open ? "true" : "false");
        }
        const panel = item.querySelector(".credentials-panel");
        if (panel instanceof HTMLElement) {
            if (open) panel.removeAttribute("inert");
            else panel.setAttribute("inert", "");
        }
    }

    function initCredentialsAccordion() {
        const root = document.querySelector("[data-credentials-accordion]");
        if (!(root instanceof HTMLElement) || root.dataset.bound === "true") return;
        root.dataset.bound = "true";

        const items = Array.from(root.querySelectorAll(".credentials-item"));

        items.forEach((item) => {
            const trigger = item.querySelector(".credentials-trigger");
            if (!(trigger instanceof HTMLButtonElement)) return;

            trigger.addEventListener("click", () => {
                const willOpen = item.getAttribute("data-open") !== "true";
                items.forEach((other) => {
                    setCredentialsOpen(other, other === item && willOpen);
                });
            });
        });
    }

    initCredentialsAccordion();
    document.addEventListener("astro:page-load", initCredentialsAccordion);
</script>
