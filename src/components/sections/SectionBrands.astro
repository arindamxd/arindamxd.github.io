---
// data
const metadata = (await import("../../content/brands-metadata.json")).default;
---

<section id="brands" class="section">

    <!-- Header -->
    <div class="brands-header" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;">
        <p class="proton-text proton-styles-preset-small-text" style="--proton-text-alignment:center">Proudly working/worked with</p>
    </div>

    <!-- Logo Marquee -->
    <div class="brands-logo-container">
        <div class="brands-logo-row logo-strip" style="width: 100%;">
            <div class="brands-logo-strip-container">

                <section style="display: flex; width: 100%; height: 100%; max-width: 100%; max-height: 100%; place-items: center; margin: 0px; padding: 10px; list-style-type: none; opacity: 1; mask-image: linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgb(0, 0, 0) 12.5%, rgb(0, 0, 0) 87.5%, rgba(0, 0, 0, 0) 100%); overflow: hidden;">
                    <div id="logo-track" class="logo-track" style={`--logo-count: ${metadata.length}; --logo-width: 8rem; --animation-duration: calc(var(--logo-count) * 5s);`}>
                        <!-- Logo Items -->
                        {metadata.map((brand) => (
                            <div class="logo-item" style="flex-shrink: 0; opacity: 1;">
                                <div class="brand-logo-box" style="image-rendering: pixelated; flex-shrink: 0; fill: black; color: black; opacity: 1;">
                                    <div class="svg-container" style="width:100%;height:100%;aspect-ratio:inherit">
                                        <img decoding="auto" src={brand} alt="" style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:cover" />
                                    </div>
                                </div>
                            </div>
                        ))}
                        <!-- Duplicate for seamless loop -->
                        {metadata.map((brand) => (
                            <div class="logo-item" style="flex-shrink: 0; opacity: 1;">
                                <div class="brand-logo-box" style="image-rendering: pixelated; flex-shrink: 0; fill: black; color: black; opacity: 1;">
                                    <div class="svg-container" style="width:100%;height:100%;aspect-ratio:inherit">
                                        <img decoding="auto" src={brand} alt="" style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:cover" />
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </section>

            </div>
        </div>
    </div>

</section>