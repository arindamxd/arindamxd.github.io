---
import { previewBrands } from "../../utils/design-preview-data";

interface Props {
    preview?: boolean;
}

const { preview = false } = Astro.props;

const metadata = preview
    ? previewBrands
    : (await import("../../content/brands-metadata.json")).default;

const logos = metadata.logos;
---

<section
    id={preview ? "brands-preview" : "brands"}
    class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-[30px] overflow-visible p-0 max-narrow:gap-5 max-narrow:px-2.5"
>
    <div class="relative flex h-auto w-full flex-none flex-col justify-start opacity-60">
        <p class="m-0 p-0 font-manrope text-[13px] font-semibold leading-[120%] tracking-[-0.05em] text-center text-text max-narrow:text-[12px]">
            {metadata.title}
        </p>
    </div>

    <div class="relative h-auto w-full flex-none">
        <div class="relative flex h-[52px] w-full max-w-[550px] flex-row flex-nowrap content-center items-center justify-center gap-2.5 overflow-hidden p-0">
            <div class="relative h-full w-px flex-1">
                <div
                    class="flex size-full max-h-full max-w-full place-items-center overflow-hidden p-2.5 opacity-100 [mask-image:linear-gradient(to_right,rgba(0,0,0,0)_0%,rgb(0,0,0)_12.5%,rgb(0,0,0)_87.5%,rgba(0,0,0,0)_100%)]"
                >
                    <div
                        class="logo-track"
                        style={`--logo-count: ${logos.length}; --logo-width: 8rem; --animation-duration: calc(var(--logo-count) * 5s);`}
                    >
                        {logos.map((brand) => (
                            <div class="logo-item opacity-100">
                                <div
                                    class="relative aspect-[3.75/1] h-auto w-[105px] flex-none opacity-100"
                                    style="image-rendering: pixelated"
                                >
                                    <div class="aspect-[inherit] size-full">
                                        <img
                                            decoding="async"
                                            loading="lazy"
                                            width="105"
                                            height="28"
                                            src={brand}
                                            alt=""
                                            class="block size-full rounded-[inherit] object-cover object-center dark:brightness-0 dark:invert dark:opacity-70"
                                        />
                                    </div>
                                </div>
                            </div>
                        ))}
                        {logos.map((brand) => (
                            <div class="logo-item opacity-100">
                                <div
                                    class="relative aspect-[3.75/1] h-auto w-[105px] flex-none opacity-100"
                                    style="image-rendering: pixelated"
                                >
                                    <div class="aspect-[inherit] size-full">
                                        <img
                                            decoding="async"
                                            loading="lazy"
                                            width="105"
                                            height="28"
                                            src={brand}
                                            alt=""
                                            class="block size-full rounded-[inherit] object-cover object-center dark:brightness-0 dark:invert dark:opacity-70"
                                        />
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
