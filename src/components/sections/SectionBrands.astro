---
// data
const metadata = (await import("../../content/brands-metadata.json")).default;
---

<section id="brands" class="appear-fade-up appear-delay-5 relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-[30px] overflow-visible p-0 max-framer:gap-5 max-framer:px-2.5">

    <!-- Header -->
    <div class="relative flex h-auto w-full flex-none flex-col justify-start opacity-60">
        <p class="m-0 p-0 font-manrope text-[13px] font-semibold leading-[120%] tracking-[-0.05em] text-center text-text max-framer:text-[12px]">Proudly worked with</p>
    </div>

    <!-- Logo Marquee -->
    <div class="relative h-auto w-full flex-none">
        <div class="relative flex h-[52px] w-full max-w-[550px] flex-row flex-nowrap content-center items-center justify-center gap-2.5 overflow-hidden p-0">
            <div class="relative h-full w-px flex-1">
                <div
                    class="flex size-full max-h-full max-w-full place-items-center overflow-hidden p-2.5 opacity-100 [mask-image:linear-gradient(to_right,rgba(0,0,0,0)_0%,rgb(0,0,0)_12.5%,rgb(0,0,0)_87.5%,rgba(0,0,0,0)_100%)]"
                >
                    <div
                        id="logo-track"
                        class="logo-track"
                        style={`--logo-count: ${metadata.length}; --logo-width: 8rem; --animation-duration: calc(var(--logo-count) * 5s);`}
                    >
                        {metadata.map((brand) => (
                            <div class="logo-item opacity-100">
                                <div
                                    class="relative aspect-[3.75/1] h-auto w-[105px] flex-none text-black fill-black opacity-100"
                                    style="image-rendering: pixelated"
                                >
                                    <div class="aspect-[inherit] size-full">
                                        <img
                                            decoding="auto"
                                            src={brand}
                                            alt=""
                                            class="block size-full rounded-[inherit] object-cover object-center"
                                        />
                                    </div>
                                </div>
                            </div>
                        ))}
                        {metadata.map((brand) => (
                            <div class="logo-item opacity-100">
                                <div
                                    class="relative aspect-[3.75/1] h-auto w-[105px] flex-none text-black fill-black opacity-100"
                                    style="image-rendering: pixelated"
                                >
                                    <div class="aspect-[inherit] size-full">
                                        <img
                                            decoding="auto"
                                            src={brand}
                                            alt=""
                                            class="block size-full rounded-[inherit] object-cover object-center"
                                        />
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>
