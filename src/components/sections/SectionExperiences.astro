---
import type { Experience } from "../../types/experience";
import { formatDateByYear } from "../../utils/date";

// data
const metadata = (await import("../../content/experiences-metadata.json")).default;

const today = new Date();
const start = metadata.data.length > 0 ? new Date(metadata.data.reduce((earliest, exp) =>
    new Date(exp.start) < new Date(earliest.start) ? exp : earliest
).start) : new Date();

let yearsOfExperience = today.getFullYear() - start.getFullYear();
// if today’s month/day is before Oct 1, subtract 1 because the year isn’t complete
if (today.getMonth() < start.getMonth() || (today.getMonth() === start.getMonth() && today.getDate() < start.getDate())) {
    yearsOfExperience--;
}

const currentYear = new Date().getFullYear();
const yearList = Array.from({ length: 5 }, (_, i) => (currentYear - 1) - i);

const experienceList: Experience[] = metadata.data.map(experience => ({
    ...experience,
    start: new Date(experience.start),
    end: experience.end === "-" ? "-" : new Date(experience.end),
}));

// sort by date descending
const sorted = [...experienceList].sort((a, b) =>
    b.start.getTime() - a.start.getTime()
);

// show only 4 items
const items = sorted.slice(0, 4);
---

<section id="experiences" class="section" style="will-change: transform;">

    <div class="experience-header">
        <div class="experience-header-container">
            <div class="experience-header-yoe" style="outline:none;display:flex;flex-direction:column;justify-content:flex-end;flex-shrink:0;transform:none">
                <p class="proton-text proton-styles-preset-large" style="--proton-text-alignment:right;--proton-text-color:var(--color-bg)">{yearsOfExperience}</p>
            </div>
            <div class="experience-header-plus">
                <div class="plus-icon" style="image-rendering:pixelated;flex-shrink:0" aria-hidden="true">
                    <div class="svg-container" style="width:100%;height:100%;aspect-ratio:inherit">
                        <img decoding="auto" loading="lazy" src="/assets/resources/plus.svg" alt="" style="display:block;width:100%;height:100%;border-radius:inherit;object-position:center;object-fit:cover;">
                    </div>
                </div>
            </div>
            <div class="experience-header-text" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none">
                <p class="proton-text proton-styles-preset-role" style="--proton-text-color:rgba(255, 255, 255, 0.6)">Years of experience</p>
                <p class="proton-text proton-styles-preset-role" style="--proton-text-color:var(--color-surface)">in product development</p>
            </div>
        </div>
        <div class="experience-header-ladder">
            <div class="ladder-icon" style="image-rendering:pixelated;flex-shrink:0" aria-hidden="true">
                <div class="svg-container" style="width:100%;height:100%;aspect-ratio:inherit">
                    <svg style="width:100%;height:100%;"><use href="#svg12488493370"></use></svg>
                </div>
            </div>
        </div>
    </div>
    
    <div class="experience-body">
        <div class="section">
            <div class="experience-timeline" data-border="true">
                <div class="experience-timeline-gradient" />
                <div class="experience-timeline-current">
                    <div class="experience-timeline-current-ellipse" />
                    <div class="experience-timeline-current-number">
                        <div class="experience-timeline-current-number-text" style="outline: none; display: flex; flex-direction: column; justify-content: flex-end; flex-shrink: 0; will-change: transform; transform: none;">
                            <p class="proton-text" style="--proton-font-family:&quot;Manrope&quot;, &quot;Manrope Placeholder&quot;, sans-serif;--proton-font-size:52px;--proton-font-weight:600;--proton-letter-spacing:-0.05em;--proton-line-height:100%;--proton-text-color:rgb(23, 23, 23)">{currentYear}</p>
                        </div>
                    </div>
                </div>
                <div class="experience-timeline-past">
                    {yearList.map((year) => (
                        <div class="experience-timeline-past-item">
                            <div class="experience-timeline-past-ellipse" />
                            <div class="experience-timeline-past-number">
                                <div class="experience-timeline-past-number-text" style="outline: none; display: flex; flex-direction: column; justify-content: flex-end; flex-shrink: 0; will-change: transform; opacity: 0.4; transform: none;">
                                    <p class="proton-text proton-styles-preset-past-year">{year}</p>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
            <div class="experience-body-content">
                <div class="experience-body-content-title" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none">
                    <h3 class="proton-text proton-styles-preset-title-2">{metadata.title}</h3>
                </div>
                <div class="experience-body-content-description" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none">
                    <p class="proton-text proton-styles-preset-paragraph">{metadata.description}</p>
                </div>
            </div>
        </div>

        <div class="experience-body-table">
            {items.map(experience => (
                <div class="experience-body-table-items-container">
                    <div class="experience-two-column-row typography-card-title main-container" data-border="true" style="--border-bottom-width: 0px; --border-color: var(--color-border); --border-left-width: 0px; --border-right-width: 0px; --border-style: solid; --border-top-width: 1px; width: 100%;">
                        <div class="experience-column-left">
                            <div class="text-block" style="outline: none; display: flex; flex-direction: column; justify-content: flex-start; flex-shrink: 0; --proton-paragraph-spacing: 0px; transform: none;">
                                <p class="proton-text proton-styles-preset-default" style="--proton-text-color:var(--color-text)">{experience.title}</p>
                            </div>
                        </div>
                        <div class="experience-column-right">
                            <div class="text-block" style="outline: none; display: flex; flex-direction: column; justify-content: flex-start; flex-shrink: 0; --proton-paragraph-spacing: 0px; transform: none;">
                                <p class="proton-text proton-styles-preset-role" style="--proton-text-alignment:right">{experience.company}</p>
                            </div>
                            <div class="text-block" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;--proton-paragraph-spacing:0px;opacity:0.6;transform:none">
                                <p class="proton-text proton-styles-preset-role" style="--proton-text-alignment:right">{formatDateByYear(experience.start)} - {formatDateByYear(experience.end)}</p>
                            </div>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>

</section>