---
import ElementSkill from "./../elements/SkillElement.astro";

// data
const metadata = (await import("../../content/skills-metadata.json")).default;

const stack = metadata.tech.stack || [];
const tools = metadata.tech.tools || [];
---

<section id="skills" class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-[50px] overflow-visible p-0 max-framer:gap-[30px] max-framer:px-2.5">

    <!-- Heading -->
    <div data-reveal class="relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-start gap-6 overflow-visible p-0 max-framer:gap-4">
        <div class="relative h-auto w-full flex-none text-balance">
            <h2 class="m-0 p-0 font-manrope text-[50px] font-semibold leading-[110%] tracking-[-0.05em] text-center text-text no-underline max-framer:text-[34px]">{metadata.title}</h2>
        </div>
        <div class="relative h-auto w-full max-w-[350px] flex-none whitespace-pre-wrap break-words text-balance opacity-60">
            <p class="m-0 p-0 font-manrope text-[17px] font-semibold leading-[140%] tracking-[-0.04em] text-text no-underline max-framer:text-[15px] text-center">{metadata.description}</p>
        </div>
    </div>

    <div
        data-reveal
        data-reveal-stagger
        class="relative flex h-min w-full flex-none flex-col flex-nowrap content-start items-start justify-start gap-3 overflow-visible"
    >
        {stack.length > 0 && (
            <div class="relative h-full w-full flex-none">
                <div class="relative flex h-min w-full flex-row flex-wrap content-center items-center justify-center gap-3 overflow-visible">
                    {stack.map((item, i) => (
                        <ElementSkill icon={item.icon} label={item.label} index={i} />
                    ))}
                </div>
            </div>
        )}
        {tools.length > 0 && (
            <div class="relative h-full w-full flex-none">
                <div class="relative flex h-min w-full flex-row flex-wrap content-center items-center justify-center gap-3 overflow-visible">
                    {tools.map((item, i) => (
                        <ElementSkill icon={item.icon} label={item.label} index={stack.length + i} />
                    ))}
                </div>
            </div>
        )}
    </div>

</section>
