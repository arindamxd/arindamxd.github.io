---
import ElementSkill from "./../elements/SkillElement.astro";
import SectionHeading from "../elements/SectionHeading.astro";

// data
const metadata = (await import("../../content/skills-metadata.json")).default;

const stack = metadata.tech.stack || [];
const tools = metadata.tech.tools || [];
---

<section id="skills" class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-0 overflow-visible p-0 max-narrow:px-2.5">

    <SectionHeading title={metadata.title} description={metadata.description} />

    <div
        data-reveal
        data-reveal-stagger
        class="relative flex h-min w-full flex-none flex-col flex-nowrap content-start items-start justify-start gap-3 overflow-visible"
    >
        {stack.length > 0 && (
            <div class="relative h-full w-full flex-none">
                <div class="relative flex h-min w-full flex-row flex-wrap content-center items-center justify-center gap-3 overflow-visible">
                    {stack.map((item, i) => (
                        <ElementSkill icon={item.icon} label={item.label} description={item.description} index={i} />
                    ))}
                </div>
            </div>
        )}
        {tools.length > 0 && (
            <div class="relative h-full w-full flex-none">
                <div class="relative flex h-min w-full flex-row flex-wrap content-center items-center justify-center gap-3 overflow-visible">
                    {tools.map((item, i) => (
                        <ElementSkill icon={item.icon} label={item.label} description={item.description} index={stack.length + i} />
                    ))}
                </div>
            </div>
        )}
    </div>

</section>
