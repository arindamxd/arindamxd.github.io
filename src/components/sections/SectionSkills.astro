---
import ElementSkill from "./../elements/SkillElement.astro";

// data
const metadata = (await import("../../content/skills-metadata.json")).default;
---

<section id="skills" class="section">

    <!-- Heading -->
    <div class="section-header">
        <div class="section-header-title" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none">
            <h2 class="proton-text proton-styles-preset-heading-2">{metadata.title}</h2>
        </div>
        <div class="section-header-description" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none">
            <p class="proton-text proton-styles-preset-paragraph" style="--proton-text-alignment:center;">{metadata.description}</p>
        </div>
    </div>

    <div class="skills-items" style="will-change: transform;">
        {metadata.tech.stack.length > 0 && (
            <div class="skills-row">
                <div class="skills-item-container">
                    <div class="skills-item-content">
                        {metadata.tech.stack.map((item) => (
                            <ElementSkill icon={item.icon} label={item.label} />
                        ))}
                    </div>
                </div>
            </div>
        )}
        {metadata.tech.tools.length > 0 && (
            <div class="skills-row">
                <div class="skills-item-container">
                    <div class="skills-item-content">
                        {metadata.tech.tools.map((item) => (
                            <ElementSkill icon={item.icon} label={item.label} />
                        ))}
                    </div>
                </div>
            </div>
        )}
    </div>

</section>