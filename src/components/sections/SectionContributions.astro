---
import GitHubContributionsCalendar from "../elements/GitHubContributionsCalendar";
import SectionHeading from "../elements/SectionHeading.astro";
import {
    previewContributionDays,
    previewContributionsMeta,
} from "../../utils/design-preview-data";

interface Props {
    preview?: boolean;
    /** Override metadata usernames; contribution days are merged by date. */
    usernames?: string[];
}

const { preview = false } = Astro.props;

const liveMeta = preview
    ? null
    : (await import("../../content/contributions-metadata.json")).default;

const metadata = preview ? previewContributionsMeta : liveMeta!;
const { usernames = metadata.usernames } = Astro.props;

type ContributionDay = {
    date: string;
    count: number;
    level: number;
};

type ContributionsResponse = {
    total?: { lastYear?: number };
    contributions?: ContributionDay[];
};

function levelForCount(count: number, max: number): number {
    if (count <= 0 || max <= 0) return 0;
    return Math.min(4, Math.max(1, Math.ceil((count / max) * 4)));
}

function mergeContributionDays(sets: ContributionDay[][]): ContributionDay[] {
    const byDate = new Map<string, number>();

    for (const set of sets) {
        for (const day of set) {
            byDate.set(day.date, (byDate.get(day.date) ?? 0) + day.count);
        }
    }

    const max = Math.max(0, ...byDate.values());

    return [...byDate.entries()]
        .sort(([a], [b]) => a.localeCompare(b))
        .map(([date, count]) => ({
            date,
            count,
            level: levelForCount(count, max),
        }));
}

let contributions: ContributionDay[] = [];
let totalCount = 0;

if (preview) {
    contributions = previewContributionDays();
    totalCount = contributions.reduce((sum, day) => sum + day.count, 0);
} else {
    const fetched = await Promise.all(
        usernames.map(async (username) => {
            try {
                const response = await fetch(
                    `https://github-contributions-api.jogruber.de/v4/${username}?y=last`,
                );
                if (!response.ok) return [] as ContributionDay[];
                const data = (await response.json()) as ContributionsResponse;
                return Array.isArray(data.contributions) ? data.contributions : [];
            } catch {
                return [] as ContributionDay[];
            }
        }),
    );

    contributions = mergeContributionDays(fetched.filter((set) => set.length > 0));
    totalCount = contributions.reduce((sum, day) => sum + day.count, 0);
}

const label = preview ? "preview" : usernames.join(" + ");
---

<section
    id={preview ? "contributions-preview" : "contributions"}
    class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-0 overflow-visible p-0 max-narrow:px-2.5"
>
    <SectionHeading title={metadata.title} description={metadata.description} />

    <div
        data-reveal
        class="relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-center overflow-visible p-0"
    >
        <GitHubContributionsCalendar
            client:load
            username={label}
            contributions={contributions}
            totalCount={totalCount}
        />
    </div>
</section>
