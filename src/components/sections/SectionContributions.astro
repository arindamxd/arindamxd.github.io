---
import GitHubContributionsCalendar from "../elements/GitHubContributionsCalendar";

interface Props {
    username?: string;
}

const { username = "arindamxd" } = Astro.props;

type ContributionDay = {
    date: string;
    count: number;
    level: number;
};

type ContributionsResponse = {
    total?: { lastYear?: number };
    contributions?: ContributionDay[];
};

let contributions: ContributionDay[] = [];
let totalCount = 0;

try {
    const response = await fetch(
        `https://github-contributions-api.jogruber.de/v4/${username}?y=last`,
    );
    if (response.ok) {
        const data = (await response.json()) as ContributionsResponse;
        contributions = Array.isArray(data.contributions) ? data.contributions : [];
        totalCount =
            typeof data.total?.lastYear === "number"
                ? data.total.lastYear
                : contributions.reduce((sum, day) => sum + day.count, 0);
    }
} catch {
    // Keep empty calendar if the upstream API is unreachable at build/request time.
}
---

<section
    id="contributions"
    class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-[50px] overflow-visible p-0 max-narrow:gap-[30px] max-narrow:px-2.5"
>
    <div
        data-reveal
        class="relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-start gap-3 overflow-visible p-0 max-narrow:gap-2.5"
    >
        <div class="relative h-auto w-full flex-none text-balance">
            <h2
                class="m-0 p-0 text-center font-manrope text-[50px] font-semibold leading-[110%] tracking-[-0.05em] text-text no-underline max-narrow:text-[34px]"
            >
                Contributions
            </h2>
        </div>
        <div
            class="relative h-auto w-full max-w-[350px] flex-none whitespace-pre-wrap break-words text-balance opacity-60"
        >
            <p
                class="m-0 p-0 text-center font-manrope text-[17px] font-semibold leading-[140%] tracking-[-0.04em] text-text no-underline max-narrow:text-[15px]"
            >
                Public GitHub activity over the last year.
            </p>
        </div>
    </div>

    <div
        data-reveal
        class="relative flex h-min w-full flex-none flex-col flex-nowrap content-center items-center justify-center overflow-visible p-0"
    >
        <GitHubContributionsCalendar
            client:load
            username={username}
            contributions={contributions}
            totalCount={totalCount}
        />
    </div>
</section>
