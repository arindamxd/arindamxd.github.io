---
// data
const author = (await import("../../content/author-metadata.json")).default;
---

<section class="relative flex h-min w-full max-w-[550px] flex-none flex-col flex-nowrap content-center items-center justify-center gap-[50px] overflow-visible p-0 max-narrow:gap-[30px] max-narrow:px-2.5">

    <div class="hero-tie-container" style="transform: translateX(-50%);">
        <div class="hero-tie hero-tie-centered">
            <div class="hero-tie-stripe"></div>
            <div class="hero-tie-holder" style="background-color: rgb(23, 23, 23); border-radius: 6px; opacity: 1;"></div>
            <div class="hero-tie-box" style="background: linear-gradient(rgb(7, 7, 7) 0%, rgb(45, 45, 45) 100%); border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; opacity: 1;"></div>
        </div>
    </div>

    <div class="hero-badge">
        <div class="hero-card shadow-[inset_0_0_0_1px_var(--color-border)]" id="hero">
            <div class="hero-card-hole shadow-[inset_0_0_0_1px_var(--color-border)]"></div>

            <div class="hero-card-content">
                <div class="relative flex h-min w-full flex-none flex-col flex-nowrap items-start justify-start gap-8 overflow-visible p-0 pt-5">
                    <h1 class="m-0 w-full p-0 font-manrope text-[141px] font-semibold leading-[90%] tracking-[-0.09em] text-left text-text">404</h1>
                    <div class="relative flex h-min w-full flex-none flex-col flex-nowrap items-start justify-start gap-5 overflow-visible p-0">
                        <p class="m-0 w-full p-0 font-manrope text-[26px] font-semibold leading-[125%] tracking-[-0.04em] text-left text-text max-narrow:text-[24px]">Page not found</p>
                        <p class="m-0 w-full p-0 font-manrope text-[17px] font-semibold leading-[155%] tracking-[-0.04em] text-left text-text no-underline opacity-60 max-narrow:text-[15px]">The page you are looking for could not be found</p>
                    </div>
                </div>

                <div class="hero-card-content-buttons">
                    <div class="relative h-auto w-auto flex-none">
                        <a class="group relative flex h-[58px] w-min cursor-pointer flex-row flex-nowrap content-center items-center justify-start gap-4 overflow-hidden rounded-full py-[3px] pr-[74px] pl-7 no-underline" href="/">
                            <div class="relative z-[2] h-auto w-auto flex-none whitespace-pre">
                                <p class="m-0 p-0 font-manrope text-[17px] font-semibold leading-[140%] tracking-[-0.04em] text-white no-underline max-narrow:text-[15px]">Go back home</p>
                            </div>
                            <div class="absolute top-[3px] right-[3px] z-[2] flex h-[52px] w-[52px] flex-col flex-nowrap content-center items-center justify-center rounded-full bg-white p-0">
                                <div class="relative h-2.5 w-2.5 flex-none transition-transform duration-200 ease-out group-hover:rotate-45" style="image-rendering: pixelated;">
                                    <div class="h-full w-full" style="aspect-ratio:inherit">
                                        <svg class="h-full w-full"><use href="#link-arrow"></use></svg>
                                    </div>
                                </div>
                            </div>
                            <div class="absolute inset-0 z-0 overflow-hidden rounded-full bg-primary transition-[filter] duration-200 ease-in-out group-hover:brightness-95"></div>
                        </a>
                    </div>
                </div>
            </div>

            <div class="hero-card-bottom">
                <div class="hero-card-bottom-location">
                    <div class="location-icon text-text" style="image-rendering:pixelated;flex-shrink:0;fill:currentColor;color:currentColor">
                        <div class="svg-container" style="width:100%;height:100%;aspect-ratio:inherit">
                            <svg style="width:100%;height:100%;" viewBox="0 0 13 14" preserveAspectRatio="none" width="100%" height="100%"><use href="#svg-1885035283_1212"></use></svg>
                        </div>
                    </div>
                    <div class="location-text-container" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none">
                        <p class="m-0 p-0 font-manrope text-[13px] font-semibold leading-[120%] tracking-[-0.04em] text-left text-text max-narrow:text-[12px] max-narrow:tracking-[-0.02em]"><span class="text-text/60">Located in&nbsp;</span>{author.location}<span class="text-text/60">,&nbsp;available worldwide.</span></p>
                    </div>
                </div>
                <div class="relative flex h-auto w-auto flex-none items-center">
                    <a class="group relative flex h-min w-min cursor-pointer flex-row flex-nowrap items-center justify-start gap-[7px] overflow-visible py-0 no-underline" href={author.intro.cardLinkURL} target="_blank" rel="noopener">
                        <p class="m-0 p-0 font-manrope text-[14px] font-semibold leading-[130%] tracking-[-0.04em] text-text no-underline max-narrow:text-[13px]">{author.intro.cardLinkText}</p>
                        <div class="relative h-2.5 w-2.5 flex-none transition-transform duration-200 ease-out group-hover:rotate-45">
                            <svg class="h-full w-full"><use href="#link-arrow"></use></svg>
                        </div>
                    </a>
                </div>
            </div>

        </div>
    </div>

</section>
